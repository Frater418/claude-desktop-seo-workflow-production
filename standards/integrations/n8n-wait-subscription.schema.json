{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/integrations/n8n-wait-subscription.schema.json",
  "title": "Heartweb n8n Local Wait Subscription",
  "type": "object",
  "additionalProperties": false,
  "required": ["subscription_id", "schema_version", "integration_mode", "simulation_id", "command_id", "event_type", "tenant_id", "project_id", "run_id", "step_id", "expected_revision", "correlation_id", "idempotency_key", "created_at"],
  "properties": {
    "subscription_id": {"type": "string", "pattern": "^wait-[a-z0-9][a-z0-9-]{7,63}$"}, "schema_version": {"const": "2.0.0"}, "integration_mode": {"const": "simulated"}, "simulation_id": {"type": "string", "pattern": "^sim-[a-z0-9][a-z0-9-]{7,63}$"}, "command_id": {"type": "string", "pattern": "^command-[a-z0-9][a-z0-9-]{7,63}$"}, "event_type": {"enum": ["gate.approved", "gate.rejected", "task.resolved", "blocker.resolved"]}, "tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "step_id": {"enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "expected_revision": {"type": "integer", "minimum": 1}, "correlation_id": {"type": "string", "pattern": "^corr-[a-z0-9][a-z0-9-]{7,63}$"}, "idempotency_key": {"type": "string", "pattern": "^idem-[a-z0-9][a-z0-9-]{7,127}$"}, "created_at": {"type": "string", "format": "date-time"}
  }
}
