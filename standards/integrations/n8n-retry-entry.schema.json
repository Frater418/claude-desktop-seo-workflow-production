{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/integrations/n8n-retry-entry.schema.json",
  "title": "Heartweb n8n Local Retry Entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["retry_id", "schema_version", "integration_mode", "simulation_id", "delivery_id", "attempt", "max_attempts", "scheduled_at", "correlation_id", "idempotency_key", "tenant_id", "project_id", "run_id", "step_id", "expected_revision"],
  "properties": {
    "retry_id": {"type": "string", "pattern": "^retry-[a-z0-9][a-z0-9-]{7,63}$"}, "schema_version": {"const": "2.0.0"}, "integration_mode": {"const": "simulated"}, "simulation_id": {"type": "string", "pattern": "^sim-[a-z0-9][a-z0-9-]{7,63}$"}, "delivery_id": {"type": "string", "pattern": "^delivery-[a-z0-9][a-z0-9-]{7,63}$"}, "attempt": {"enum": [1, 2]}, "max_attempts": {"const": 3}, "scheduled_at": {"type": "string", "format": "date-time"}, "correlation_id": {"type": "string", "pattern": "^corr-[a-z0-9][a-z0-9-]{7,63}$"}, "idempotency_key": {"type": "string", "pattern": "^idem-[a-z0-9][a-z0-9-]{7,127}$"}, "tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "step_id": {"enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "expected_revision": {"type": "integer", "minimum": 1}
  }
}
