{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/integrations/workflow-event-v2.schema.json",
  "title": "Heartweb Append-Only Workflow Event V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "correlation_id", "idempotency_key", "identity", "integration_mode", "payload"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^event-[a-z0-9][a-z0-9-]{7,63}$"},
    "event_type": {"enum": ["project.created", "run.started", "step.blocked", "artifact.created", "gate.ready", "gate.approved", "gate.rejected", "task.created", "task.resolved", "defect.created", "escalation.created", "run.resumed", "release.created", "assignment.created", "approval.recorded", "blocker.resolved", "performance.checkpoint_due", "metric.recorded", "adjustment.proposed", "integration.delivery_failed", "integration.conflict_detected"]},
    "schema_version": {"const": "2.0.0"}, "occurred_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "pattern": "^corr-[a-z0-9][a-z0-9-]{7,63}$"}, "idempotency_key": {"type": "string", "pattern": "^idem-[a-z0-9][a-z0-9-]{7,127}$"},
    "identity": {"$ref": "#/$defs/identity"}, "integration_mode": {"enum": ["simulated", "live"]},
    "simulation_id": {"type": "string", "pattern": "^sim-[a-z0-9][a-z0-9-]{7,63}$"}, "live_connection_id": {"type": "string", "pattern": "^live-[a-z0-9][a-z0-9-]{7,63}$"},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"integration_mode": {"const": "simulated"}}}, "then": {"required": ["simulation_id"], "not": {"required": ["live_connection_id"]}}},
    {"if": {"properties": {"integration_mode": {"const": "live"}}}, "then": {"required": ["live_connection_id"], "not": {"required": ["simulation_id"]}}},
    {"if": {"properties": {"event_type": {"const": "project.created"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/projectCreatedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "run.started"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/runStartedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "step.blocked"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/stepBlockedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "artifact.created"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/artifactCreatedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "gate.ready"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/gateReadyPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "gate.approved"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/gateApprovedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "gate.rejected"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/gateRejectedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "task.created"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/taskCreatedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "task.resolved"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/taskResolvedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "defect.created"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/defectCreatedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "escalation.created"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/escalationCreatedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "run.resumed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/runResumedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "release.created"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/releaseCreatedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "assignment.created"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/assignmentCreatedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "approval.recorded"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/approvalRecordedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "blocker.resolved"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/blockerResolvedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "performance.checkpoint_due"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/performanceCheckpointDuePayload"}}}},
    {"if": {"properties": {"event_type": {"const": "metric.recorded"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/metricRecordedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "adjustment.proposed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/adjustmentProposedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "integration.delivery_failed"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/integrationDeliveryFailedPayload"}}}},
    {"if": {"properties": {"event_type": {"const": "integration.conflict_detected"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/integrationConflictDetectedPayload"}}}}
  ],
  "$defs": {
    "identity": {"type": "object", "additionalProperties": false, "required": ["tenant_id", "project_id", "run_id", "step_id", "revision"], "properties": {"tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "step_id": {"enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "revision": {"type": "integer", "minimum": 1}, "artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}}},
    "projectCreatedPayload": {"type": "object", "additionalProperties": false, "required": ["customer_id", "owner_id"], "properties": {"customer_id": {"type": "string", "pattern": "^customer-[a-z0-9-]+$"}, "owner_id": {"type": "string", "pattern": "^owner-[a-z0-9-]+$"}}},
    "runStartedPayload": {"type": "object", "additionalProperties": false, "required": ["attempt", "input_hash"], "properties": {"attempt": {"type": "integer", "minimum": 1}, "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "stepBlockedPayload": {"type": "object", "additionalProperties": false, "required": ["blocker_id", "reason"], "properties": {"blocker_id": {"type": "string", "pattern": "^blocker-[a-z0-9-]+$"}, "reason": {"type": "string", "minLength": 1}}},
    "artifactCreatedPayload": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "content_sha256"], "properties": {"artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9-]+$"}, "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "gateReadyPayload": {"type": "object", "additionalProperties": false, "required": ["gate_id"], "properties": {"gate_id": {"type": "string", "pattern": "^GATE-(0|1|1B|1C|2|3|3B|4A|4B)$"}}},
    "gateApprovedPayload": {"type": "object", "additionalProperties": false, "required": ["gate_id", "approval_id"], "properties": {"gate_id": {"type": "string"}, "approval_id": {"type": "string", "pattern": "^approval-[a-z0-9-]+$"}}},
    "gateRejectedPayload": {"type": "object", "additionalProperties": false, "required": ["gate_id", "reason"], "properties": {"gate_id": {"type": "string"}, "reason": {"type": "string", "minLength": 1}}},
    "taskCreatedPayload": {"type": "object", "additionalProperties": false, "required": ["task_id", "task_type"], "properties": {"task_id": {"type": "string", "pattern": "^task-[a-z0-9-]+$"}, "task_type": {"type": "string", "minLength": 1}}},
    "taskResolvedPayload": {"type": "object", "additionalProperties": false, "required": ["task_id", "resolution_id"], "properties": {"task_id": {"type": "string", "pattern": "^task-[a-z0-9-]+$"}, "resolution_id": {"type": "string", "pattern": "^resolution-[a-z0-9-]+$"}}},
    "defectCreatedPayload": {"type": "object", "additionalProperties": false, "required": ["defect_id", "severity"], "properties": {"defect_id": {"type": "string", "pattern": "^defect-[a-z0-9-]+$"}, "severity": {"enum": ["P0", "P1", "P2", "P3"]}}},
    "escalationCreatedPayload": {"type": "object", "additionalProperties": false, "required": ["escalation_id", "decision_owner"], "properties": {"escalation_id": {"type": "string", "pattern": "^escalation-[a-z0-9-]+$"}, "decision_owner": {"enum": ["business_owner", "compliance_reviewer"]}}},
    "runResumedPayload": {"type": "object", "additionalProperties": false, "required": ["resume_request_id"], "properties": {"resume_request_id": {"type": "string", "pattern": "^command-[a-z0-9-]+$"}}},
    "releaseCreatedPayload": {"type": "object", "additionalProperties": false, "required": ["release_id", "gate_id"], "properties": {"release_id": {"type": "string", "pattern": "^release-[a-z0-9-]+$"}, "gate_id": {"type": "string"}}},
    "assignmentCreatedPayload": {"type": "object", "additionalProperties": false, "required": ["assignment_id", "task_id", "assigned_role"], "properties": {"assignment_id": {"type": "string", "pattern": "^assignment-[a-z0-9-]+$"}, "task_id": {"type": "string", "pattern": "^task-[a-z0-9-]+$"}, "assigned_role": {"enum": ["copywriter", "designer", "developer", "reviewer"]}}},
    "approvalRecordedPayload": {"type": "object", "additionalProperties": false, "required": ["approval_id", "gate_id", "decision"], "properties": {"approval_id": {"type": "string", "pattern": "^approval-[a-z0-9-]+$"}, "gate_id": {"type": "string"}, "decision": {"enum": ["approved", "rejected"]}}},
    "blockerResolvedPayload": {"type": "object", "additionalProperties": false, "required": ["blocker_id", "resolution_id"], "properties": {"blocker_id": {"type": "string", "pattern": "^blocker-[a-z0-9-]+$"}, "resolution_id": {"type": "string", "pattern": "^resolution-[a-z0-9-]+$"}}},
    "performanceCheckpointDuePayload": {"type": "object", "additionalProperties": false, "required": ["checkpoint_id", "day_after_publication"], "properties": {"checkpoint_id": {"type": "string", "pattern": "^checkpoint-[a-z0-9-]+$"}, "day_after_publication": {"enum": [30, 60, 90]}}},
    "metricRecordedPayload": {"type": "object", "additionalProperties": false, "required": ["metric_id", "metric_name", "value", "unit"], "properties": {"metric_id": {"type": "string", "pattern": "^metric-[a-z0-9-]+$"}, "metric_name": {"type": "string", "minLength": 1}, "value": {"type": "number"}, "unit": {"type": "string", "minLength": 1}}},
    "adjustmentProposedPayload": {"type": "object", "additionalProperties": false, "required": ["proposal_id", "checkpoint_id", "source_artifact_id"], "properties": {"proposal_id": {"type": "string", "pattern": "^adjustment-[a-z0-9-]+$"}, "checkpoint_id": {"type": "string", "pattern": "^checkpoint-[a-z0-9-]+$"}, "source_artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9-]+$"}}},
    "integrationDeliveryFailedPayload": {"type": "object", "additionalProperties": false, "required": ["delivery_id", "failure_code", "attempt"], "properties": {"delivery_id": {"type": "string", "pattern": "^delivery-[a-z0-9-]+$"}, "failure_code": {"type": "string", "minLength": 1}, "attempt": {"type": "integer", "minimum": 1}}},
    "integrationConflictDetectedPayload": {"type": "object", "additionalProperties": false, "required": ["conflict_id", "conflicting_revision"], "properties": {"conflict_id": {"type": "string", "pattern": "^conflict-[a-z0-9-]+$"}, "conflicting_revision": {"type": "integer", "minimum": 1}}}
  }
}
