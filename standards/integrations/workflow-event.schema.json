{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/integrations/workflow-event.schema.json",
  "title": "Heartweb Append-Only Workflow Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "event_type", "schema_version", "occurred_at", "correlation_id", "idempotency_key", "identity", "integration_mode", "payload"],
  "properties": {
    "event_id": {"type": "string", "pattern": "^event-[a-z0-9][a-z0-9-]{7,63}$"},
    "event_type": {"type": "string", "enum": ["project.created", "run.started", "step.blocked", "artifact.created", "gate.ready", "gate.approved", "gate.rejected", "task.created", "task.resolved", "defect.created", "escalation.created", "run.resumed", "release.created"]},
    "schema_version": {"const": "1.0.0"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "pattern": "^corr-[a-z0-9][a-z0-9-]{7,63}$"},
    "idempotency_key": {"type": "string", "pattern": "^idem-[a-z0-9][a-z0-9-]{7,127}$"},
    "identity": {"$ref": "#/$defs/identity"},
    "integration_mode": {"type": "string", "enum": ["simulated", "live"]},
    "simulation_id": {"type": "string", "pattern": "^sim-[a-z0-9][a-z0-9-]{7,63}$"},
    "live_connection_id": {"type": "string", "pattern": "^live-[a-z0-9][a-z0-9-]{7,63}$"},
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"integration_mode": {"const": "simulated"}}}, "then": {"required": ["simulation_id"], "not": {"required": ["live_connection_id"]}}},
    {"if": {"properties": {"integration_mode": {"const": "live"}}}, "then": {"required": ["live_connection_id"], "not": {"required": ["simulation_id"]}}},
    {"if": {"properties": {"event_type": {"const": "project.created"}}}, "then": {"properties": {"payload": {"$ref": "#/$defs/projectCreated"}}}},
    {"if": {"properties": {"event_type": {"const": "run.started"}}}, "then": {"properties": {"identity": {"$ref": "#/$defs/runIdentity"}, "payload": {"$ref": "#/$defs/runStarted"}}}},
    {"if": {"properties": {"event_type": {"const": "step.blocked"}}}, "then": {"properties": {"identity": {"$ref": "#/$defs/runIdentity"}, "payload": {"$ref": "#/$defs/stepBlocked"}}}},
    {"if": {"properties": {"event_type": {"const": "artifact.created"}}}, "then": {"properties": {"identity": {"$ref": "#/$defs/artifactIdentity"}, "payload": {"$ref": "#/$defs/artifactCreated"}}}},
    {"if": {"properties": {"event_type": {"const": "gate.ready"}}}, "then": {"properties": {"identity": {"$ref": "#/$defs/artifactIdentity"}, "payload": {"$ref": "#/$defs/gateReady"}}}},
    {"if": {"properties": {"event_type": {"const": "gate.approved"}}}, "then": {"properties": {"identity": {"$ref": "#/$defs/artifactIdentity"}, "payload": {"$ref": "#/$defs/gateApproved"}}}},
    {"if": {"properties": {"event_type": {"const": "gate.rejected"}}}, "then": {"properties": {"identity": {"$ref": "#/$defs/artifactIdentity"}, "payload": {"$ref": "#/$defs/gateRejected"}}}},
    {"if": {"properties": {"event_type": {"const": "task.created"}}}, "then": {"properties": {"identity": {"$ref": "#/$defs/runIdentity"}, "payload": {"$ref": "#/$defs/taskCreated"}}}},
    {"if": {"properties": {"event_type": {"const": "task.resolved"}}}, "then": {"properties": {"identity": {"$ref": "#/$defs/runIdentity"}, "payload": {"$ref": "#/$defs/taskResolved"}}}},
    {"if": {"properties": {"event_type": {"const": "defect.created"}}}, "then": {"properties": {"identity": {"$ref": "#/$defs/runIdentity"}, "payload": {"$ref": "#/$defs/defectCreated"}}}},
    {"if": {"properties": {"event_type": {"const": "escalation.created"}}}, "then": {"properties": {"identity": {"$ref": "#/$defs/runIdentity"}, "payload": {"$ref": "#/$defs/escalationCreated"}}}},
    {"if": {"properties": {"event_type": {"const": "run.resumed"}}}, "then": {"properties": {"identity": {"$ref": "#/$defs/runIdentity"}, "payload": {"$ref": "#/$defs/runResumed"}}}},
    {"if": {"properties": {"event_type": {"const": "release.created"}}}, "then": {"properties": {"identity": {"$ref": "#/$defs/artifactIdentity"}, "payload": {"$ref": "#/$defs/releaseCreated"}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["tenant_id", "project_id"], "properties": {"tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "step_id": {"type": "string", "enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "revision": {"type": "integer", "minimum": 1}, "artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}}},
    "runIdentity": {"allOf": [{"$ref": "#/$defs/identity"}, {"required": ["run_id", "step_id", "revision"]}]},
    "artifactIdentity": {"allOf": [{"$ref": "#/$defs/runIdentity"}, {"required": ["artifact_id"]}]},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "revision", "content_sha256"], "properties": {"artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "revision": {"type": "integer", "minimum": 1}, "content_sha256": {"$ref": "#/$defs/sha256"}}},
    "projectCreated": {"type": "object", "additionalProperties": false, "required": ["project_name", "owner_id"], "properties": {"project_name": {"type": "string", "minLength": 1}, "owner_id": {"type": "string", "pattern": "^owner-[a-z0-9][a-z0-9-]{2,63}$"}}},
    "runStarted": {"type": "object", "additionalProperties": false, "required": ["attempt", "input_hash"], "properties": {"attempt": {"type": "integer", "minimum": 1}, "input_hash": {"$ref": "#/$defs/sha256"}}},
    "stepBlocked": {"type": "object", "additionalProperties": false, "required": ["blocker_id", "blocker_type", "reason"], "properties": {"blocker_id": {"type": "string", "pattern": "^blocker-[a-z0-9][a-z0-9-]{7,63}$"}, "blocker_type": {"type": "string", "enum": ["input", "technical", "quality", "compliance", "provider", "management"]}, "reason": {"type": "string", "minLength": 1}}},
    "artifactCreated": {"type": "object", "additionalProperties": false, "required": ["artifact"], "properties": {"artifact": {"$ref": "#/$defs/artifact"}}},
    "gateReady": {"type": "object", "additionalProperties": false, "required": ["gate_id", "artifact_sha256"], "properties": {"gate_id": {"type": "string", "pattern": "^GATE-(0|1|1B|1C|2|3|3B|4A|4B)$"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}},
    "gateApproved": {"type": "object", "additionalProperties": false, "required": ["gate_id", "approval_id", "artifact_sha256"], "properties": {"gate_id": {"type": "string", "pattern": "^GATE-(0|1|1B|1C|2|3|3B|4A|4B)$"}, "approval_id": {"type": "string", "pattern": "^approval-[a-z0-9][a-z0-9-]{7,63}$"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}},
    "gateRejected": {"type": "object", "additionalProperties": false, "required": ["gate_id", "rejection_id", "reason"], "properties": {"gate_id": {"type": "string", "pattern": "^GATE-(0|1|1B|1C|2|3|3B|4A|4B)$"}, "rejection_id": {"type": "string", "pattern": "^rejection-[a-z0-9][a-z0-9-]{7,63}$"}, "reason": {"type": "string", "minLength": 1}}},
    "taskCreated": {"type": "object", "additionalProperties": false, "required": ["task_id", "task_type", "blocking"], "properties": {"task_id": {"type": "string", "pattern": "^task-[a-z0-9][a-z0-9-]{7,63}$"}, "task_type": {"type": "string", "minLength": 1}, "blocking": {"type": "boolean"}}},
    "taskResolved": {"type": "object", "additionalProperties": false, "required": ["task_id", "resolution_id"], "properties": {"task_id": {"type": "string", "pattern": "^task-[a-z0-9][a-z0-9-]{7,63}$"}, "resolution_id": {"type": "string", "pattern": "^resolution-[a-z0-9][a-z0-9-]{7,63}$"}}},
    "defectCreated": {"type": "object", "additionalProperties": false, "required": ["defect_id", "severity"], "properties": {"defect_id": {"type": "string", "pattern": "^defect-[a-z0-9][a-z0-9-]{7,63}$"}, "severity": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]}}},
    "escalationCreated": {"type": "object", "additionalProperties": false, "required": ["escalation_id", "decision_owner"], "properties": {"escalation_id": {"type": "string", "pattern": "^escalation-[a-z0-9][a-z0-9-]{7,63}$"}, "decision_owner": {"type": "string", "enum": ["business_owner", "compliance_reviewer"]}}},
    "runResumed": {"type": "object", "additionalProperties": false, "required": ["resume_command_id"], "properties": {"resume_command_id": {"type": "string", "pattern": "^command-[a-z0-9][a-z0-9-]{7,63}$"}}},
    "releaseCreated": {"type": "object", "additionalProperties": false, "required": ["release_id", "gate_id", "artifact_sha256"], "properties": {"release_id": {"type": "string", "pattern": "^release-[a-z0-9][a-z0-9-]{7,63}$"}, "gate_id": {"type": "string", "pattern": "^GATE-(0|1|1B|1C|2|3|3B|4A|4B)$"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
