{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/integrations/n8n-command.schema.json",
  "title": "Heartweb n8n Orchestration Command",
  "type": "object",
  "additionalProperties": false,
  "required": ["command_id", "schema_version", "tenant_id", "project_id", "run_id", "step_id", "correlation_id", "idempotency_key", "expected_revision", "integration_mode", "requested_at", "command_type", "target"],
  "properties": {
    "command_id": {"type": "string", "pattern": "^command-[a-z0-9][a-z0-9-]{7,63}$"},
    "schema_version": {"const": "1.0.0"},
    "tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"},
    "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"},
    "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"},
    "step_id": {"type": "string", "enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]},
    "correlation_id": {"type": "string", "pattern": "^corr-[a-z0-9][a-z0-9-]{7,63}$"},
    "idempotency_key": {"type": "string", "pattern": "^idem-[a-z0-9][a-z0-9-]{7,127}$"},
    "expected_revision": {"type": "integer", "minimum": 1},
    "integration_mode": {"type": "string", "enum": ["simulated", "live"]},
    "simulation_id": {"type": "string", "pattern": "^sim-[a-z0-9][a-z0-9-]{7,63}$"},
    "live_connection_id": {"type": "string", "pattern": "^live-[a-z0-9][a-z0-9-]{7,63}$"},
    "requested_at": {"type": "string", "format": "date-time"},
    "command_type": {"type": "string", "enum": ["dispatch_tool_run", "wait_for_gate", "retry_delivery", "resume_run", "dead_letter"]},
    "target": {"$ref": "#/$defs/target"}
  },
  "allOf": [
    {"if": {"properties": {"integration_mode": {"const": "simulated"}}}, "then": {"required": ["simulation_id"], "not": {"required": ["live_connection_id"]}}},
    {"if": {"properties": {"integration_mode": {"const": "live"}}}, "then": {"required": ["live_connection_id"], "not": {"required": ["simulation_id"]}}}
  ],
  "$defs": {
    "target": {"type": "object", "additionalProperties": false, "required": ["service", "operation"], "properties": {"service": {"type": "string", "enum": ["workflow_api", "tool_runner", "delivery_queue"]}, "operation": {"type": "string", "enum": ["dispatch", "wait", "retry", "resume", "dead_letter"]}}}
  }
}
