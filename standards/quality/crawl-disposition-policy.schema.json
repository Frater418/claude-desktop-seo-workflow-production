{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.dev/schemas/quality/crawl-disposition-policy.schema.json",
  "title": "Heartweb Crawl Disposition Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "version", "rules"],
  "properties": {
    "policy_id": {"const": "heartweb-crawl-disposition"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_key", "allowed_count", "applicability", "step1_disposition", "step4b_disposition", "failure_code"],
      "properties": {
        "finding_key": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "allowed_count": {"type": "integer", "minimum": 0},
        "applicability": {"enum": ["always", "when_multilingual"]},
        "step1_disposition": {"enum": ["pass", "advisory", "waiver_required", "block"]},
        "step4b_disposition": {"enum": ["pass", "advisory", "waiver_required", "block"]},
        "failure_code": {"type": "string", "pattern": "^ERROR_[A-Z0-9_]+$"}
      }
    }
  }
}
