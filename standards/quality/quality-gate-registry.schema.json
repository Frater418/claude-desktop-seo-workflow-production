{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.dev/schemas/quality/quality-gate-registry.schema.json",
  "title": "Heartweb Quality Gate Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "author", "gates"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "author": {"const": "Raphael Rechberger"},
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/gate"}
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "steps", "stage", "gate_type", "enforcement", "applicability", "binding_scope", "blocks_operations", "waiver_allowed", "tools", "requirements", "failure_code", "remediation", "evidence_required"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^qg-[a-z0-9-]+$"},
        "steps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b", "runtime"]}},
        "stage": {"enum": ["preflight", "validation", "human_approval", "staging", "post_publication"]},
        "gate_type": {"enum": ["preflight", "revision", "escalation", "abort"]},
        "human_gate_id": {"type": "string", "pattern": "^GATE-(0|1|1B|1C|2|3|3B|4A|4B)$"},
        "enforcement": {"enum": ["blocking", "advisory"]},
        "applicability": {"enum": ["always", "when_existing_site", "when_multilingual", "when_ymyl", "when_local", "when_configured", "when_production"]},
        "binding_scope": {"enum": ["current_artifact", "supporting_artifact", "transition", "external_evidence"]},
        "blocks_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["start", "submit_for_gate", "approve", "complete", "publish", "post_publication"]}},
        "waiver_allowed": {"type": "boolean"},
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool_id", "mode"],
            "properties": {
              "tool_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
              "mode": {"enum": ["required", "conditional", "independent_verification"]}
            }
          }
        },
        "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
        "failure_code": {"type": "string", "pattern": "^ERROR_[A-Z0-9_]+$"},
        "remediation": {"type": "string", "minLength": 10},
        "evidence_required": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
      },
      "allOf": [
        {"if": {"properties": {"stage": {"const": "human_approval"}}}, "then": {"required": ["human_gate_id"]}}
      ]
    }
  }
}
