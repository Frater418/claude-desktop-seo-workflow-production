{
  "schema_version": "1.1.0",
  "author": "Raphael Rechberger",
  "gates": [
    {
      "gate_id": "qg-domain-contract",
      "steps": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"],
      "stage": "preflight",
      "gate_type": "preflight",
      "enforcement": "blocking",
      "applicability": "always",
      "binding_scope": "supporting_artifact",
      "blocks_operations": ["start", "submit_for_gate"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "jsonschema", "mode": "required"}],
      "requirements": ["Project, deployment, run and input artifacts validate against closed contracts", "Unknown fields and invalid references are rejected"],
      "failure_code": "ERROR_DOMAIN_CONTRACT_INVALID",
      "remediation": "Correct the source artifact or migrate it through an approved versioned migration before running the step.",
      "evidence_required": ["schema_id", "schema_version", "artifact_sha256", "validator_result"]
    },
    {
      "gate_id": "qg-step1-crawl-snapshot",
      "steps": ["1"],
      "stage": "preflight",
      "gate_type": "preflight",
      "enforcement": "blocking",
      "applicability": "when_existing_site",
      "binding_scope": "supporting_artifact",
      "blocks_operations": ["submit_for_gate"],
      "waiver_allowed": true,
      "tools": [{"tool_id": "screaming-frog-cli", "mode": "required"}],
      "requirements": ["Headless crawl exits successfully", "Internal, response code, title, meta, H1, H2, canonical, hreflang, structured data, links and security exports exist", "Crawl URL limit is not reached", "Every export is hashed"],
      "failure_code": "ERROR_STEP1_CRAWL_EVIDENCE_INVALID",
      "remediation": "Repair the crawl configuration or site access, provide a licensed crawl for sites above the active URL limit, and rerun the crawl snapshot.",
      "evidence_required": ["crawl_manifest", "start_url", "tool_version", "export_hashes", "url_count", "issues_overview"]
    },
    {
      "gate_id": "qg-step1-independent-search-verification",
      "steps": ["1"],
      "stage": "validation",
      "gate_type": "preflight",
      "enforcement": "blocking",
      "applicability": "when_configured",
      "binding_scope": "external_evidence",
      "blocks_operations": ["submit_for_gate"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "ahrefs", "mode": "independent_verification"}, {"tool_id": "google-search-console", "mode": "independent_verification"}],
      "requirements": ["Configured sources preserve raw evidence and retrieval timestamps", "Missing configured access creates one explicit operator blocker", "Provider and model conclusions remain separated"],
      "failure_code": "ERROR_STEP1_INDEPENDENT_EVIDENCE_UNAVAILABLE",
      "remediation": "Restore the configured Ahrefs or Search Console access or record an explicit not-applicable decision before the gate can continue.",
      "evidence_required": ["source_status", "retrieved_at", "raw_artifact_hash", "scope"]
    },
    {
      "gate_id": "qg-gate1-artifact-approval",
      "steps": ["1"],
      "stage": "human_approval",
      "gate_type": "escalation",
      "human_gate_id": "GATE-1",
      "enforcement": "blocking",
      "applicability": "always",
      "binding_scope": "current_artifact",
      "blocks_operations": ["approve", "complete"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "heartweb-transition-service", "mode": "required"}],
      "requirements": ["Topic inventory passes its output contract", "Approval binds run ID, artifact ID, SHA-256, policy version and reviewer", "A changed artifact invalidates the approval"],
      "failure_code": "ERROR_GATE1_APPROVAL_INVALID",
      "remediation": "Review the exact current artifact revision and submit a new approval record with all required identity and hash fields.",
      "evidence_required": ["artifact_id", "artifact_sha256", "approval_id", "reviewer_id", "decided_at"]
    },
    {
      "gate_id": "qg-step2-provider-evidence",
      "steps": ["2"],
      "stage": "validation",
      "gate_type": "revision",
      "enforcement": "blocking",
      "applicability": "always",
      "binding_scope": "external_evidence",
      "blocks_operations": ["submit_for_gate"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "dataforseo", "mode": "required"}, {"tool_id": "agentseo", "mode": "conditional"}],
      "requirements": ["Market deployment, locale, device, budget and idempotency key are explicit", "Raw provider payload and response hash are preserved", "Returned geography matches the requested deployment"],
      "failure_code": "ERROR_PROVIDER_EVIDENCE_INVALID",
      "remediation": "Correct provider routing or market data and resume the same idempotent operation without generating replacement metrics.",
      "evidence_required": ["request_hash", "raw_response_hash", "provider_job_id", "market_assertion", "cost"]
    },
    {
      "gate_id": "qg-step3-deterministic-plan",
      "steps": ["3"],
      "stage": "validation",
      "gate_type": "revision",
      "enforcement": "blocking",
      "applicability": "always",
      "binding_scope": "current_artifact",
      "blocks_operations": ["submit_for_gate"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "capacity-matrix-solver", "mode": "required"}],
      "requirements": ["No missing metrics or unknown content types", "Mandatory items and backlog integrity are preserved", "Capacity constraints and solver version are recorded"],
      "failure_code": "ERROR_PLAN_SOLVER_INVALID",
      "remediation": "Correct the structured keyword dataset or capacity policy and rerun the deterministic solver.",
      "evidence_required": ["input_hash", "solver_version", "output_hash", "allocated_count", "backlog_count"]
    },
    {
      "gate_id": "qg-step4a-claims-and-schema",
      "steps": ["4a"],
      "stage": "validation",
      "gate_type": "revision",
      "enforcement": "blocking",
      "applicability": "always",
      "binding_scope": "current_artifact",
      "blocks_operations": ["submit_for_gate"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "heartweb-jsonld-validator", "mode": "required"}, {"tool_id": "screaming-frog-structured-data", "mode": "independent_verification"}, {"tool_id": "google-rich-results-test", "mode": "independent_verification"}],
      "requirements": ["Every regulated or YMYL claim has approved evidence", "JSON-LD validation levels are reported separately", "External rich-result verification is recorded for production eligibility"],
      "failure_code": "ERROR_BRIEFING_EVIDENCE_OR_SCHEMA_INVALID",
      "remediation": "Correct claims, evidence, entity references or structured data and obtain the required reviewer decision before handoff.",
      "evidence_required": ["claim_ledger", "validator_levels", "schema_hash", "review_decision"]
    },
    {
      "gate_id": "qg-step4b-staging-technical",
      "steps": ["4b"],
      "stage": "staging",
      "gate_type": "revision",
      "enforcement": "blocking",
      "applicability": "when_production",
      "binding_scope": "current_artifact",
      "blocks_operations": ["publish"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "screaming-frog-cli", "mode": "required"}, {"tool_id": "lighthouse", "mode": "required"}, {"tool_id": "axe", "mode": "required"}, {"tool_id": "browser-visual-regression", "mode": "required"}],
      "requirements": ["No critical crawl, schema, accessibility, consent, form, link or canonical errors", "Approved content hash matches staging", "Responsive visual diffs are within the approved threshold"],
      "failure_code": "ERROR_STAGING_TECHNICAL_QA_FAILED",
      "remediation": "Correct the staging implementation and rerun every failed technical gate before deployment approval.",
      "evidence_required": ["staging_url", "crawl_manifest", "lighthouse_report", "axe_report", "visual_diff_report", "content_hash"]
    },
    {
      "gate_id": "qg-performance-measurement",
      "steps": ["3b"],
      "stage": "post_publication",
      "gate_type": "revision",
      "enforcement": "blocking",
      "applicability": "always",
      "binding_scope": "external_evidence",
      "blocks_operations": ["post_publication"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "google-search-console", "mode": "required"}, {"tool_id": "ga4", "mode": "conditional"}, {"tool_id": "google-business-profile", "mode": "conditional"}, {"tool_id": "ahrefs", "mode": "independent_verification"}],
      "requirements": ["Measurement source matches the conversion model", "Baseline, comparison window, completeness and confidence are explicit", "The original plan remains immutable until an adjustment proposal is approved"],
      "failure_code": "ERROR_PERFORMANCE_EVIDENCE_INVALID",
      "remediation": "Restore the required measurement source or correct the incomplete evidence before creating an adjustment proposal.",
      "evidence_required": ["measurement_plan_id", "source_artifact_ids", "baseline", "comparison_window", "completeness", "confidence"]
    },
    {
      "gate_id": "qg-gate0-project-approval",
      "steps": ["0"],
      "stage": "human_approval",
      "gate_type": "escalation",
      "human_gate_id": "GATE-0",
      "enforcement": "blocking",
      "applicability": "always",
      "binding_scope": "current_artifact",
      "blocks_operations": ["approve", "complete"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "heartweb-transition-service", "mode": "required"}],
      "requirements": ["Project scope, markets, services and workstreams are reviewed", "Approval binds the current artifact revision and SHA-256"],
      "failure_code": "ERROR_GATE0_APPROVAL_INVALID",
      "remediation": "Review the current Step 0 artifact and submit a revision-bound GATE-0 approval.",
      "evidence_required": ["artifact_id", "artifact_sha256", "approval_id", "reviewer_id", "decided_at"]
    },
    {
      "gate_id": "qg-step1b-architecture-integrity",
      "steps": ["1b"],
      "stage": "validation",
      "gate_type": "revision",
      "enforcement": "blocking",
      "applicability": "always",
      "binding_scope": "current_artifact",
      "blocks_operations": ["submit_for_gate"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "architecture-contract-validator", "mode": "required"}, {"tool_id": "link-map-validator", "mode": "required"}],
      "requirements": ["Every approved topic maps to one canonical destination", "Navigation, redirects, canonicals and internal links contain no conflict or orphan"],
      "failure_code": "ERROR_STEP1B_ARCHITECTURE_INVALID",
      "remediation": "Correct the URL, navigation, redirect, canonical or link graph and rerun architecture validation.",
      "evidence_required": ["architecture_hash", "topic_coverage", "orphan_count", "conflict_count", "validator_result"]
    },
    {
      "gate_id": "qg-gate1b-architecture-approval",
      "steps": ["1b"],
      "stage": "human_approval",
      "gate_type": "escalation",
      "human_gate_id": "GATE-1B",
      "enforcement": "blocking",
      "applicability": "always",
      "binding_scope": "current_artifact",
      "blocks_operations": ["approve", "complete"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "heartweb-transition-service", "mode": "required"}],
      "requirements": ["Architecture is reviewed against the approved topic inventory", "Approval binds the current architecture revision and SHA-256"],
      "failure_code": "ERROR_GATE1B_APPROVAL_INVALID",
      "remediation": "Review the current architecture artifact and submit a revision-bound GATE-1B approval.",
      "evidence_required": ["artifact_id", "artifact_sha256", "approval_id", "reviewer_id", "decided_at"]
    },
    {
      "gate_id": "qg-step1c-design-system",
      "steps": ["1c"],
      "stage": "validation",
      "gate_type": "revision",
      "enforcement": "blocking",
      "applicability": "always",
      "binding_scope": "current_artifact",
      "blocks_operations": ["submit_for_gate"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "css-token-validator", "mode": "required"}, {"tool_id": "axe", "mode": "required"}, {"tool_id": "browser-visual-regression", "mode": "required"}],
      "requirements": ["Design tokens are complete and schema-valid", "Templates pass accessibility and responsive visual comparison"],
      "failure_code": "ERROR_STEP1C_DESIGN_SYSTEM_INVALID",
      "remediation": "Correct design tokens, component states, accessibility or responsive rendering and rerun validation.",
      "evidence_required": ["design_token_hash", "axe_report", "visual_diff_report", "viewport_matrix"]
    },
    {
      "gate_id": "qg-gate1c-design-approval",
      "steps": ["1c"],
      "stage": "human_approval",
      "gate_type": "escalation",
      "human_gate_id": "GATE-1C",
      "enforcement": "blocking",
      "applicability": "always",
      "binding_scope": "current_artifact",
      "blocks_operations": ["approve", "complete"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "heartweb-transition-service", "mode": "required"}],
      "requirements": ["Design and templates are reviewed against brand and architecture evidence", "Approval binds the current design revision and SHA-256"],
      "failure_code": "ERROR_GATE1C_APPROVAL_INVALID",
      "remediation": "Review the current design artifact and submit a revision-bound GATE-1C approval.",
      "evidence_required": ["artifact_id", "artifact_sha256", "approval_id", "reviewer_id", "decided_at"]
    },
    {
      "gate_id": "qg-gate2-data-approval",
      "steps": ["2"],
      "stage": "human_approval",
      "gate_type": "escalation",
      "human_gate_id": "GATE-2",
      "enforcement": "blocking",
      "applicability": "always",
      "binding_scope": "current_artifact",
      "blocks_operations": ["approve", "complete"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "heartweb-transition-service", "mode": "required"}],
      "requirements": ["Coverage, intent and provider evidence are reviewed", "Approval binds the current research dataset revision and SHA-256"],
      "failure_code": "ERROR_GATE2_APPROVAL_INVALID",
      "remediation": "Review the current research artifact and submit a revision-bound GATE-2 approval.",
      "evidence_required": ["artifact_id", "artifact_sha256", "approval_id", "reviewer_id", "decided_at"]
    },
    {
      "gate_id": "qg-gate3-plan-approval",
      "steps": ["3"],
      "stage": "human_approval",
      "gate_type": "escalation",
      "human_gate_id": "GATE-3",
      "enforcement": "blocking",
      "applicability": "always",
      "binding_scope": "current_artifact",
      "blocks_operations": ["approve", "complete"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "heartweb-transition-service", "mode": "required"}],
      "requirements": ["Capacity, priorities, backlog and link graph are reviewed", "Approval binds the current plan revision and SHA-256"],
      "failure_code": "ERROR_GATE3_APPROVAL_INVALID",
      "remediation": "Review the current plan artifact and submit a revision-bound GATE-3 approval.",
      "evidence_required": ["artifact_id", "artifact_sha256", "approval_id", "reviewer_id", "decided_at"]
    },
    {
      "gate_id": "qg-gate4a-briefing-approval",
      "steps": ["4a"],
      "stage": "human_approval",
      "gate_type": "escalation",
      "human_gate_id": "GATE-4A",
      "enforcement": "blocking",
      "applicability": "always",
      "binding_scope": "current_artifact",
      "blocks_operations": ["approve", "complete"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "heartweb-transition-service", "mode": "required"}],
      "requirements": ["Briefing, claims, citations and schema are reviewed", "Approval binds the current briefing revision and SHA-256"],
      "failure_code": "ERROR_GATE4A_APPROVAL_INVALID",
      "remediation": "Review the current briefing artifact and submit a revision-bound GATE-4A approval.",
      "evidence_required": ["artifact_id", "artifact_sha256", "approval_id", "reviewer_id", "decided_at"]
    },
    {
      "gate_id": "qg-gate4b-deployment-approval",
      "steps": ["4b"],
      "stage": "human_approval",
      "gate_type": "escalation",
      "human_gate_id": "GATE-4B",
      "enforcement": "blocking",
      "applicability": "always",
      "binding_scope": "current_artifact",
      "blocks_operations": ["approve", "complete", "publish"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "heartweb-transition-service", "mode": "required"}],
      "requirements": ["Staging evidence and deployment target are reviewed", "Approval binds the exact staging content hash and rollback revision"],
      "failure_code": "ERROR_GATE4B_APPROVAL_INVALID",
      "remediation": "Review the verified staging artifact and submit a revision-bound GATE-4B deployment approval.",
      "evidence_required": ["artifact_id", "artifact_sha256", "approval_id", "reviewer_id", "rollback_revision", "decided_at"]
    },
    {
      "gate_id": "qg-gate3b-adjustment-approval",
      "steps": ["3b"],
      "stage": "human_approval",
      "gate_type": "escalation",
      "human_gate_id": "GATE-3B",
      "enforcement": "blocking",
      "applicability": "always",
      "binding_scope": "current_artifact",
      "blocks_operations": ["approve", "complete", "post_publication"],
      "waiver_allowed": false,
      "tools": [{"tool_id": "heartweb-transition-service", "mode": "required"}],
      "requirements": ["Measurement evidence and adjustment proposal are reviewed", "The original plan remains immutable and approval creates a new revision"],
      "failure_code": "ERROR_GATE3B_APPROVAL_INVALID",
      "remediation": "Review the current adjustment proposal and submit a revision-bound GATE-3B approval.",
      "evidence_required": ["artifact_id", "artifact_sha256", "approval_id", "reviewer_id", "decided_at"]
    }
  ]
}
