{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/delivery/notion-import-manifest.schema.json",
  "title": "Heartweb Manual Notion Import Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["notion_import_manifest_id", "schema_version", "tenant_id", "project_id", "export_id", "delivery_package_id", "integration_mode", "source_snapshot_revision", "source_records", "files", "customer_rows", "project_rows", "artifact_rows", "review_rows", "approval_rows", "blocker_rows", "task_rows", "assignment_rows", "priority_rows", "deadline_rows", "relations", "performance_checkpoint_rows", "unresolved_assignee_ids", "user_mapping_template_path", "manifest_sha256", "created_at"],
  "properties": {
    "notion_import_manifest_id": {"type": "string", "pattern": "^notion-import-[a-z0-9][a-z0-9-]{7,63}$"}, "schema_version": {"const": "1.0.0"}, "tenant_id": {"$ref": "#/$defs/tenantId"}, "project_id": {"$ref": "#/$defs/projectId"}, "export_id": {"$ref": "#/$defs/exportId"}, "delivery_package_id": {"type": "string", "pattern": "^delivery-package-[a-z0-9][a-z0-9-]{7,63}$"}, "integration_mode": {"const": "manual_import"}, "source_snapshot_revision": {"type": "integer", "minimum": 1},
    "source_records": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceRecord"}}, "files": {"type": "array", "minItems": 14, "uniqueItems": true, "allOf": [{"contains": {"properties": {"file_name": {"const": "priorities.csv"}}, "required": ["file_name"]}}, {"contains": {"properties": {"file_name": {"const": "deadlines.csv"}}, "required": ["file_name"]}}, {"contains": {"properties": {"file_name": {"const": "performance-checkpoints.csv"}}, "required": ["file_name"]}}], "items": {"$ref": "#/$defs/file"}}, "customer_rows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/customerRow"}}, "project_rows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/projectRow"}}, "artifact_rows": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactRow"}}, "review_rows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/coreRow"}}, "approval_rows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/coreRow"}}, "blocker_rows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/coreRow"}},
    "task_rows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/taskRow"}}, "assignment_rows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/assignmentRow"}}, "priority_rows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/valueRow"}}, "deadline_rows": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/valueRow"}}, "relations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/relation"}}, "performance_checkpoint_rows": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "allOf": [{"contains": {"properties": {"day_after_publication": {"const": 30}}, "required": ["day_after_publication"]}}, {"contains": {"properties": {"day_after_publication": {"const": 60}}, "required": ["day_after_publication"]}}, {"contains": {"properties": {"day_after_publication": {"const": 90}}, "required": ["day_after_publication"]}}], "items": {"$ref": "#/$defs/performanceRow"}},
    "unresolved_assignee_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^assignment-[a-z0-9][a-z0-9-]{7,63}$"}}, "user_mapping_template_path": {"$ref": "#/$defs/safePath"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "tenantId": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "projectId": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "exportId": {"type": "string", "pattern": "^delivery-export-[a-z0-9][a-z0-9-]{7,63}$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "safePath": {"type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "sourceRecord": {"type": "object", "additionalProperties": false, "required": ["tenant_id", "project_id", "source_record_id", "source_sha256"], "properties": {"tenant_id": {"$ref": "#/$defs/tenantId"}, "project_id": {"$ref": "#/$defs/projectId"}, "source_record_id": {"type": "string", "pattern": "^(?:project|artifact|task|assignment|publication-registry)-[a-z0-9][a-z0-9-]{2,63}$"}, "source_sha256": {"$ref": "#/$defs/sha256"}}}, "customerRow": {"type": "object", "additionalProperties": false, "required": ["external_id", "source_sha256"], "properties": {"external_id": {"type": "string", "pattern": "^customer-[a-z0-9][a-z0-9-]{2,63}$"}, "source_sha256": {"$ref": "#/$defs/sha256"}}}, "projectRow": {"type": "object", "additionalProperties": false, "required": ["external_id", "customer_external_id", "tenant_id", "project_id", "source_sha256"], "properties": {"external_id": {"$ref": "#/$defs/projectId"}, "customer_external_id": {"type": "string", "pattern": "^customer-[a-z0-9][a-z0-9-]{2,63}$"}, "tenant_id": {"$ref": "#/$defs/tenantId"}, "project_id": {"$ref": "#/$defs/projectId"}, "source_sha256": {"$ref": "#/$defs/sha256"}}}, "artifactRow": {"type": "object", "additionalProperties": false, "required": ["external_id", "project_external_id", "tenant_id", "project_id", "content_sha256", "revision", "relative_path", "role", "read_only"], "properties": {"external_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "project_external_id": {"$ref": "#/$defs/projectId"}, "tenant_id": {"$ref": "#/$defs/tenantId"}, "project_id": {"$ref": "#/$defs/projectId"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "revision": {"type": "integer", "minimum": 1}, "relative_path": {"$ref": "#/$defs/safePath"}, "role": {"enum": ["strategy", "architecture", "roadmap", "copywriter", "developer", "concept"]}, "read_only": {"const": true}}}, "coreRow": {"type": "object", "additionalProperties": false, "required": ["external_id", "project_external_id", "artifact_external_id", "source_sha256", "read_only"], "properties": {"external_id": {"type": "string", "pattern": "^(?:review|approval|blocker)-[a-z0-9][a-z0-9-]{7,63}$"}, "project_external_id": {"$ref": "#/$defs/projectId"}, "artifact_external_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "read_only": {"const": true}}},
    "file": {"type": "object", "additionalProperties": false, "required": ["file_name", "relative_path", "content_sha256", "row_count"], "properties": {"file_name": {"enum": ["projects.csv", "tasks.csv", "assignments.csv", "artifacts.csv", "reviews.csv", "approvals.csv", "blockers.csv", "priorities.csv", "deadlines.csv", "relations.csv", "performance-checkpoints.csv", "IMPORT_ORDER.md", "PROPERTY_MAPPING.md", "USER_MAPPING_TEMPLATE.csv"]}, "relative_path": {"$ref": "#/$defs/safePath"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "row_count": {"type": "integer", "minimum": 0}}},
    "taskRow": {"type": "object", "additionalProperties": false, "required": ["external_id", "tenant_id", "project_id", "task_class", "title"], "properties": {"external_id": {"type": "string", "pattern": "^task-[a-z0-9][a-z0-9-]{7,63}$"}, "tenant_id": {"$ref": "#/$defs/tenantId"}, "project_id": {"$ref": "#/$defs/projectId"}, "task_class": {"enum": ["core_history", "notion_implementation"]}, "title": {"type": "string", "minLength": 1}, "history_only": {"const": true}, "status": {"enum": ["not_started", "in_progress", "blocked", "done"]}, "comments": {"type": "string"}, "assignee": {"type": "string"}, "priority": {"enum": ["low", "medium", "high"]}, "deadline": {"type": "string", "format": "date"}, "core_effect": {"const": "none"}} , "allOf": [{"if": {"properties": {"task_class": {"const": "core_history"}}, "required": ["task_class"]}, "then": {"required": ["history_only"], "not": {"anyOf": [{"required": ["status"]}, {"required": ["comments"]}, {"required": ["assignee"]}, {"required": ["priority"]}, {"required": ["deadline"]}, {"required": ["core_effect"]}]}}}, {"if": {"properties": {"task_class": {"const": "notion_implementation"}}, "required": ["task_class"]}, "then": {"required": ["status", "comments", "assignee", "priority", "deadline", "core_effect"]}}]},
    "assignmentRow": {"type": "object", "additionalProperties": false, "required": ["external_id", "task_external_id", "assignee"], "properties": {"external_id": {"type": "string", "pattern": "^assignment-[a-z0-9][a-z0-9-]{7,63}$"}, "task_external_id": {"type": "string", "pattern": "^task-[a-z0-9][a-z0-9-]{7,63}$"}, "assignee": {"type": "string"}}}, "valueRow": {"type": "object", "additionalProperties": false, "required": ["task_external_id", "value"], "properties": {"task_external_id": {"type": "string", "pattern": "^task-[a-z0-9][a-z0-9-]{7,63}$"}, "value": {"type": "string", "minLength": 1}}},
    "relation": {"type": "object", "additionalProperties": false, "required": ["from_record_id", "to_record_id", "relation_type"], "properties": {"from_record_id": {"type": "string", "pattern": "^(?:project|artifact|task|assignment)-[a-z0-9][a-z0-9-]{2,63}$"}, "to_record_id": {"type": "string", "pattern": "^(?:project|artifact|task|assignment)-[a-z0-9][a-z0-9-]{2,63}$"}, "relation_type": {"enum": ["belongs_to", "assigned_to", "depends_on"]}}},
    "performanceRow": {"type": "object", "additionalProperties": false, "required": ["day_after_publication", "released_strategy_artifact_id", "released_plan_artifact_id", "publication_registry_record_id", "performance_data_status"], "properties": {"day_after_publication": {"enum": [30, 60, 90]}, "released_strategy_artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "released_plan_artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "publication_registry_record_id": {"type": "string", "pattern": "^publication-registry-[a-z0-9][a-z0-9-]{2,63}$"}, "performance_data_status": {"const": "pending_verified_data"}}}
  }
}
