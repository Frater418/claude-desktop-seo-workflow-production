{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/delivery/delivery-package-record.schema.json",
  "title": "Heartweb Derived Delivery Package Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["delivery_package_id", "schema_version", "tenant_id", "project_id", "export_id", "scope", "source_snapshot_revision", "source_records", "required_deliverables", "missing_deliverables", "package_paths", "package_sha256", "zip_sha256", "role_packages", "notion_import_manifest", "created_at", "package_revision", "derived_status"],
  "properties": {
    "delivery_package_id": {"type": "string", "pattern": "^delivery-package-[a-z0-9][a-z0-9-]{7,63}$"},
    "schema_version": {"const": "1.0.0"},
    "tenant_id": {"$ref": "#/$defs/tenantId"},
    "project_id": {"$ref": "#/$defs/projectId"},
    "export_id": {"$ref": "#/$defs/exportId"},
    "scope": {"enum": ["checkpoint", "final"]},
    "source_snapshot_revision": {"type": "integer", "minimum": 1},
    "source_records": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceRecord"}},
    "required_deliverables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/deliverable"}},
    "missing_deliverables": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/deliverableId"}},
    "package_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/safePath"}},
    "package_sha256": {"$ref": "#/$defs/sha256"},
    "zip_sha256": {"$ref": "#/$defs/sha256"},
    "role_packages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/rolePackageReference"}},
    "notion_import_manifest": {"$ref": "#/$defs/notionManifestReference"},
    "created_at": {"type": "string", "format": "date-time"},
    "package_revision": {"type": "integer", "minimum": 1},
    "derived_status": {"enum": ["prepared", "archived"]}, "task_assignment_manifest_path": {"$ref": "#/$defs/safePath"}, "quality_summary": {"type": "object", "additionalProperties": false, "required": ["summary_path", "content_sha256"], "properties": {"summary_path": {"$ref": "#/$defs/safePath"}, "content_sha256": {"$ref": "#/$defs/sha256"}}}, "export_manifest_path": {"$ref": "#/$defs/safePath"}, "checksums_path": {"$ref": "#/$defs/safePath"}
  },
  "allOf": [
    {"if": {"properties": {"scope": {"const": "final"}}, "required": ["scope"]}, "then": {"required": ["task_assignment_manifest_path", "quality_summary", "export_manifest_path", "checksums_path"], "properties": {"missing_deliverables": {"maxItems": 0}, "role_packages": {"allOf": [{"contains": {"properties": {"role": {"const": "copywriter"}}, "required": ["role"]}}, {"contains": {"properties": {"role": {"const": "developer"}}, "required": ["role"]}}]}, "required_deliverables": {"allOf": [
      {"contains": {"properties": {"deliverable_id": {"const": "strategy"}, "release_status": {"const": "released"}}, "required": ["deliverable_id", "release_status"]}, "minContains": 1},
      {"contains": {"properties": {"deliverable_id": {"const": "architecture"}, "release_status": {"const": "released"}}, "required": ["deliverable_id", "release_status"]}, "minContains": 1},
      {"contains": {"properties": {"deliverable_id": {"const": "design"}, "release_status": {"const": "released"}}, "required": ["deliverable_id", "release_status"]}, "minContains": 1},
      {"contains": {"properties": {"deliverable_id": {"const": "keyword-research"}, "release_status": {"const": "released"}}, "required": ["deliverable_id", "release_status"]}, "minContains": 1},
      {"contains": {"properties": {"deliverable_id": {"const": "roadmap"}, "release_status": {"const": "released"}}, "required": ["deliverable_id", "release_status"]}, "minContains": 1},
      {"contains": {"properties": {"deliverable_id": {"const": "copywriter-handoff"}, "release_status": {"const": "released"}}, "required": ["deliverable_id", "release_status"]}, "minContains": 1},
      {"contains": {"properties": {"deliverable_id": {"const": "developer-handoff"}, "release_status": {"const": "released"}}, "required": ["deliverable_id", "release_status"]}, "minContains": 1}
    ]}}}}
  ],
  "$defs": {
    "tenantId": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"},
    "projectId": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"},
    "exportId": {"type": "string", "pattern": "^delivery-export-[a-z0-9][a-z0-9-]{7,63}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "safePath": {"type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "deliverableId": {"enum": ["strategy", "architecture", "design", "keyword-research", "roadmap", "copywriter-handoff", "developer-handoff"]},
    "sourceRecord": {"type": "object", "additionalProperties": false, "required": ["tenant_id", "project_id", "source_kind", "source_record_id", "source_revision", "source_sha256"], "properties": {"tenant_id": {"$ref": "#/$defs/tenantId"}, "project_id": {"$ref": "#/$defs/projectId"}, "source_kind": {"enum": ["project", "workflow", "run", "artifact", "release", "task", "assignment", "review", "approval", "blocker", "report"]}, "source_record_id": {"type": "string", "pattern": "^(?:project|run|artifact|release|task|assignment|review|approval|blocker|report)-[a-z0-9][a-z0-9-]{2,63}$"}, "source_revision": {"type": "integer", "minimum": 1}, "source_sha256": {"$ref": "#/$defs/sha256"}}},
    "deliverable": {"type": "object", "additionalProperties": false, "required": ["deliverable_id", "source_record_id", "source_sha256", "package_path", "release_status"], "properties": {"deliverable_id": {"$ref": "#/$defs/deliverableId"}, "source_record_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "source_sha256": {"$ref": "#/$defs/sha256"}, "package_path": {"$ref": "#/$defs/safePath"}, "release_status": {"enum": ["released", "draft"]}}},
    "rolePackageReference": {"type": "object", "additionalProperties": false, "required": ["role", "role_handoff_manifest_id", "manifest_path", "manifest_sha256"], "properties": {"role": {"enum": ["copywriter", "developer", "project_management", "reviewer"]}, "role_handoff_manifest_id": {"type": "string", "pattern": "^role-handoff-[a-z0-9][a-z0-9-]{7,63}$"}, "manifest_path": {"$ref": "#/$defs/safePath"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}}},
    "notionManifestReference": {"type": "object", "additionalProperties": false, "required": ["notion_import_manifest_id", "manifest_path", "manifest_sha256"], "properties": {"notion_import_manifest_id": {"type": "string", "pattern": "^notion-import-[a-z0-9][a-z0-9-]{7,63}$"}, "manifest_path": {"$ref": "#/$defs/safePath"}, "manifest_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
