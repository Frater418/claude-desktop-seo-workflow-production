{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/delivery/delivery-export-request.schema.json",
  "title": "Heartweb Derived Delivery Export Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["delivery_export_request_id", "schema_version", "tenant_id", "project_id", "scope", "draft_inclusion_policy", "idempotency_key", "created_at", "source_snapshot_revision", "requested_role_packages"],
  "properties": {
    "delivery_export_request_id": {"type": "string", "pattern": "^delivery-export-request-[a-z0-9][a-z0-9-]{7,63}$"},
    "schema_version": {"const": "1.0.0"},
    "tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"},
    "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"},
    "scope": {"enum": ["checkpoint", "final"]},
    "draft_inclusion_policy": {"enum": ["exclude_drafts", "include_explicit_drafts"]},
    "idempotency_key": {"type": "string", "pattern": "^idem-[a-z0-9][a-z0-9-]{7,127}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "source_snapshot_revision": {"type": "integer", "minimum": 1},
    "requested_role_packages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["copywriter", "developer", "project_management", "reviewer"]}}
  },
  "allOf": [{"if": {"properties": {"scope": {"const": "final"}}, "required": ["scope"]}, "then": {"properties": {"draft_inclusion_policy": {"const": "exclude_drafts"}}}}]
}
