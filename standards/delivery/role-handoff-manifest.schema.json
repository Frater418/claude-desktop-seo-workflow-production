{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/delivery/role-handoff-manifest.schema.json",
  "title": "Heartweb Derived Role Handoff Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["role_handoff_manifest_id", "schema_version", "tenant_id", "project_id", "export_id", "delivery_package_id", "role", "handoff_mode", "source_snapshot_revision", "source_records", "included_paths", "unresolved_assignee_ids", "manifest_sha256", "created_at"],
  "properties": {
    "role_handoff_manifest_id": {"type": "string", "pattern": "^role-handoff-[a-z0-9][a-z0-9-]{7,63}$"}, "schema_version": {"const": "1.0.0"},
    "tenant_id": {"$ref": "#/$defs/tenantId"}, "project_id": {"$ref": "#/$defs/projectId"}, "export_id": {"$ref": "#/$defs/exportId"}, "delivery_package_id": {"type": "string", "pattern": "^delivery-package-[a-z0-9][a-z0-9-]{7,63}$"},
    "role": {"enum": ["copywriter", "developer", "project_management", "reviewer"]}, "handoff_mode": {"const": "manual_package"}, "source_snapshot_revision": {"type": "integer", "minimum": 1},
    "source_records": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceRecord"}}, "included_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/safePath"}},
    "unresolved_assignee_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^assignment-[a-z0-9][a-z0-9-]{7,63}$"}}, "manifest_sha256": {"$ref": "#/$defs/sha256"}, "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "tenantId": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "projectId": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "exportId": {"type": "string", "pattern": "^delivery-export-[a-z0-9][a-z0-9-]{7,63}$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "safePath": {"type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "sourceRecord": {"type": "object", "additionalProperties": false, "required": ["tenant_id", "project_id", "source_record_id", "source_sha256"], "properties": {"tenant_id": {"$ref": "#/$defs/tenantId"}, "project_id": {"$ref": "#/$defs/projectId"}, "source_record_id": {"type": "string", "pattern": "^(?:artifact|task|assignment|review|approval|blocker)-[a-z0-9][a-z0-9-]{2,63}$"}, "source_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
