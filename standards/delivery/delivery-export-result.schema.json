{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/delivery/delivery-export-result.schema.json",
  "title": "Heartweb Derived Delivery Export Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["delivery_export_result_id", "schema_version", "tenant_id", "project_id", "delivery_export_request_id", "export_id", "delivery_package_id", "source_snapshot_revision", "replay_state", "export_path", "zip_path", "package_sha256", "zip_sha256", "zip_size_bytes", "delivery_manifest", "role_handoff_manifests", "notion_import_manifest", "created_at"],
  "properties": {
    "delivery_export_result_id": {"type": "string", "pattern": "^delivery-export-result-[a-z0-9][a-z0-9-]{7,63}$"},
    "schema_version": {"const": "1.0.0"},
    "tenant_id": {"$ref": "#/$defs/tenantId"}, "project_id": {"$ref": "#/$defs/projectId"},
    "delivery_export_request_id": {"type": "string", "pattern": "^delivery-export-request-[a-z0-9][a-z0-9-]{7,63}$"},
    "export_id": {"type": "string", "pattern": "^delivery-export-[a-z0-9][a-z0-9-]{7,63}$"},
    "delivery_package_id": {"type": "string", "pattern": "^delivery-package-[a-z0-9][a-z0-9-]{7,63}$"},
    "source_snapshot_revision": {"type": "integer", "minimum": 1}, "replay_state": {"enum": ["created", "replayed"]},
    "export_path": {"$ref": "#/$defs/safePath"}, "zip_path": {"$ref": "#/$defs/safePath"},
    "package_sha256": {"$ref": "#/$defs/sha256"}, "zip_sha256": {"$ref": "#/$defs/sha256"}, "zip_size_bytes": {"type": "integer", "minimum": 1},
    "delivery_manifest": {"$ref": "#/$defs/manifestReference"},
    "role_handoff_manifests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/manifestReference"}},
    "notion_import_manifest": {"$ref": "#/$defs/manifestReference"}, "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "tenantId": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "projectId": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "safePath": {"type": "string", "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "manifestReference": {"type": "object", "additionalProperties": false, "required": ["manifest_id", "relative_path", "content_sha256"], "properties": {"manifest_id": {"type": "string", "pattern": "^(?:role-handoff|notion-import|delivery-package)-[a-z0-9][a-z0-9-]{7,63}$"}, "relative_path": {"$ref": "#/$defs/safePath"}, "content_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
