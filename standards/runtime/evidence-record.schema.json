{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/runtime/evidence-record.schema.json",
  "title": "Heartweb Evidence Record", "type": "object", "additionalProperties": false,
  "required": ["evidence_id", "tenant_id", "project_id", "source_type", "publisher", "source_ref", "retrieved_at", "valid_from", "jurisdiction", "content_sha256", "recorded_by"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{7,63}$"}, "tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"},
    "source_type": {"type": "string", "enum": ["url", "document", "provider_response", "manual_review"]}, "publisher": {"type": "string", "minLength": 1}, "source_ref": {"type": "string", "minLength": 1}, "retrieved_at": {"type": "string", "format": "date-time"},
    "valid_from": {"type": "string", "format": "date-time"}, "valid_until": {"type": "string", "format": "date-time"}, "jurisdiction": {"type": "string", "pattern": "^[A-Z]{2}(-[A-Z0-9]{1,3})?$"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "recorded_by": {"type": "string", "minLength": 1}
  }, "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
