{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/runtime/transition-command.schema.json",
  "title": "Heartweb Transition Command", "type": "object", "additionalProperties": false,
  "required": ["command_id", "tenant_id", "project_id", "run_id", "expected_revision", "idempotency_key", "operation", "from_step_id", "to_step_id", "input_hash", "requested_at"],
  "properties": {
    "command_id": {"type": "string", "pattern": "^command-[a-z0-9][a-z0-9-]{7,63}$"}, "tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"},
    "expected_revision": {"type": "integer", "minimum": 1}, "idempotency_key": {"type": "string", "pattern": "^idem-[a-z0-9][a-z0-9-]{7,127}$"}, "operation": {"type": "string", "enum": ["start", "submit_for_gate", "approve", "complete", "publish", "post_publication", "retry", "revise", "supersede"]},
    "from_step_id": {"type": "string", "enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "to_step_id": {"type": "string", "enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "input_hash": {"$ref": "#/$defs/sha256"}, "output_hash": {"$ref": "#/$defs/sha256"}, "requested_at": {"type": "string", "format": "date-time"},
    "predecessor_release": {"$ref": "#/$defs/predecessorRelease"}, "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}, "quality_gate": {"$ref": "#/$defs/qualityGate"}, "quality_gates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/qualityGate"}}, "approval": {"$ref": "#/$defs/approval"}, "supersedes_run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}
  },
  "allOf": [{"if": {"properties": {"operation": {"enum": ["submit_for_gate", "post_publication"]}}}, "then": {"required": ["output_hash", "artifacts"]}}, {"if": {"properties": {"operation": {"enum": ["approve", "complete", "publish"]}}}, "then": {"required": ["output_hash", "artifacts", "approval"]}}, {"if": {"properties": {"operation": {"const": "supersede"}}}, "then": {"required": ["supersedes_run_id"]}}],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "predecessorRelease": {"type": "object", "additionalProperties": false, "required": ["step_id", "gate_id", "status", "artifact_id", "artifact_sha256", "artifact_revision"], "properties": {"step_id": {"type": "string", "enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "gate_id": {"type": "string", "pattern": "^GATE-(0|1|1B|1C|2|3|3B|4A|4B)$"}, "status": {"const": "released"}, "artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "artifact_revision": {"type": "integer", "minimum": 1}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "revision", "content_sha256"], "properties": {"artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "revision": {"type": "integer", "minimum": 1}, "content_sha256": {"$ref": "#/$defs/sha256"}}},
    "qualityGate": {"type": "object", "additionalProperties": false, "required": ["quality_gate_run_id", "result", "artifact_id", "artifact_sha256"], "properties": {"quality_gate_run_id": {"type": "string", "pattern": "^qgr-[a-z0-9][a-z0-9-]{7,63}$"}, "result": {"const": "passed"}, "artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["approval_id", "gate_id", "artifact_id", "artifact_sha256", "artifact_revision", "policy_version", "reviewer_id", "decision", "decided_at", "expires_at"], "properties": {"approval_id": {"type": "string", "pattern": "^approval-[a-z0-9][a-z0-9-]{7,63}$"}, "gate_id": {"type": "string", "pattern": "^GATE-(0|1|1B|1C|2|3|3B|4A|4B)$"}, "artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "artifact_revision": {"type": "integer", "minimum": 1}, "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "reviewer_id": {"type": "string", "pattern": "^reviewer-[a-z0-9][a-z0-9-]{2,63}$"}, "decision": {"const": "approved"}, "decided_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}}}
  }
}
