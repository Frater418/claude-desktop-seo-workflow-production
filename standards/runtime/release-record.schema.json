{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/runtime/release-record.schema.json",
  "title": "Heartweb Step Release Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["release_id", "tenant_id", "project_id", "run_id", "step_id", "gate_id", "artifact_id", "artifact_sha256", "artifact_revision", "approval_id", "policy_version", "status", "released_at"],
  "properties": {
    "release_id": {"type": "string", "pattern": "^release-[a-z0-9][a-z0-9-]{7,63}$"},
    "tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"},
    "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"},
    "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"},
    "step_id": {"enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]},
    "gate_id": {"type": "string", "pattern": "^GATE-(0|1|1B|1C|2|3|3B|4A|4B)$"},
    "artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_revision": {"type": "integer", "minimum": 1},
    "approval_id": {"type": "string", "pattern": "^approval-[a-z0-9][a-z0-9-]{7,63}$"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "released"},
    "released_at": {"type": "string", "format": "date-time"}
  }
}
