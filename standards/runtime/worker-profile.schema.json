{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/runtime/worker-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "worker_profile_id",
    "schema_version",
    "profile_version",
    "profile_sha256",
    "display_name",
    "execution_kind",
    "provider_capability_ref",
    "model_policy",
    "allowed_steps",
    "tool_policy",
    "enabled",
    "created_at"
  ],
  "properties": {
    "worker_profile_id": {"type": "string", "pattern": "^worker-profile-[a-z0-9][a-z0-9-]{2,63}$"},
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "display_name": {"type": "string", "minLength": 1},
    "execution_kind": {"const": "llm"},
    "provider_capability_ref": {"$ref": "#/$defs/providerCapability"},
    "model_policy": {"$ref": "#/$defs/modelPolicy"},
    "inference_policy": {"$ref": "#/$defs/inferencePolicy"},
    "allowed_steps": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/step"}},
    "tool_policy": {"$ref": "#/$defs/toolPolicy"},
    "enabled": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "step": {"enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]},
    "providerCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "provider_kind", "capability_id"],
      "properties": {
        "provider_id": {"type": "string", "pattern": "^provider-[a-z0-9][a-z0-9-]{2,63}$"},
        "provider_kind": {"const": "gateway"},
        "capability_id": {"type": "string", "pattern": "^capability-[a-z0-9][a-z0-9-]{2,63}$"}
      }
    },
    "modelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_model_ids", "default_model_id"],
      "properties": {
        "allowed_model_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:model-[a-z0-9][a-z0-9-]{2,63}|gpt-5\\.6-sol)$"}},
        "default_model_id": {"type": "string", "pattern": "^(?:model-[a-z0-9][a-z0-9-]{2,63}|gpt-5\\.6-sol)$"}
      }
    },
    "inferencePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_provider_id", "reasoning_effort", "max_output_tokens", "timeout_seconds", "fallback_mode", "max_agent_turns", "max_tool_rounds", "delegation_policy_ref"],
      "properties": {
        "upstream_provider_id": {"const": "openai-codex"},
        "reasoning_effort": {"enum": ["none", "minimal", "low", "medium", "high", "xhigh", "max", "ultra"]},
        "max_output_tokens": {"type": "integer", "minimum": 256, "maximum": 200000},
        "timeout_seconds": {"type": "integer", "minimum": 30, "maximum": 7200},
        "fallback_mode": {"const": "fail_closed"},
        "max_agent_turns": {"type": "integer", "minimum": 1, "maximum": 90},
        "max_tool_rounds": {"type": "integer", "minimum": 0, "maximum": 20},
        "delegation_policy_ref": {"type": "string", "minLength": 1}
      }
    },
    "toolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_policy_id", "policy_version", "policy_sha256", "allowed_operations", "direct_provider_calls_allowed"],
      "properties": {
        "tool_policy_id": {"type": "string", "pattern": "^tool-policy-[a-z0-9][a-z0-9-]{2,63}$"},
        "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "allowed_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["read_context", "write_candidate_output", "request_gateway_operation", "delegate_bounded_review"]}},
        "direct_provider_calls_allowed": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1.0"}}, "required": ["schema_version"]},
      "then": {"required": ["inference_policy"]}
    }
  ]
}
