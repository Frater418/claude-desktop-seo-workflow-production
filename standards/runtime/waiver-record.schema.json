{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/runtime/waiver-record.schema.json",
  "title": "Heartweb Revision-Bound Quality Waiver",
  "type": "object",
  "additionalProperties": false,
  "required": ["waiver_id", "tenant_id", "project_id", "quality_gate_id", "artifact_id", "artifact_sha256", "policy_id", "policy_version", "step_ids", "finding_keys", "reason", "approver_id", "approved_at", "expires_at"],
  "properties": {
    "waiver_id": {"type": "string", "pattern": "^waiver-[a-z0-9][a-z0-9-]{7,63}$"},
    "tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"},
    "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"},
    "quality_gate_id": {"type": "string", "pattern": "^qg-[a-z0-9-]+$"},
    "artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_id": {"const": "heartweb-crawl-disposition"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "step_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["1", "4b"]}},
    "finding_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
    "reason": {"type": "string", "minLength": 20},
    "approver_id": {"type": "string", "pattern": "^reviewer-[a-z0-9][a-z0-9-]{2,63}$"},
    "approved_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"}
  }
}
