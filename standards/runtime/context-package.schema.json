{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/runtime/context-package.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["context_package_id", "schema_version", "tenant_id", "project_id", "run_id", "step_id", "logical_session_id", "logical_session_revision", "trigger", "target_revision", "prompt", "project_context", "worker_profile_ref", "output_contracts", "sources", "source_manifest_sha256", "package_sha256", "builder_provenance"],
  "properties": {"context_package_id": {"type": "string", "pattern": "^context-[a-z0-9][a-z0-9-]{7,63}$"}, "schema_version": {"const": "1.0.0"}, "tenant_id": {"$ref": "#/$defs/tenantId"}, "project_id": {"$ref": "#/$defs/projectId"}, "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "step_id": {"$ref": "#/$defs/step"}, "logical_session_id": {"type": "string", "pattern": "^logical-session-[a-z0-9][a-z0-9-]{7,63}$"}, "logical_session_revision": {"type": "integer", "minimum": 1}, "trigger": {"enum": ["initial_step", "next_step", "revision", "retry", "resume"]}, "target_revision": {"type": "integer", "minimum": 1}, "prompt": {"$ref": "#/$defs/prompt"}, "project_context": {"$ref": "#/$defs/projectContext"}, "worker_profile_ref": {"$ref": "#/$defs/workerProfileRef"}, "output_contracts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/outputContract"}}, "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}}, "source_manifest_sha256": {"$ref": "#/$defs/sha256"}, "package_sha256": {"$ref": "#/$defs/sha256"}, "builder_provenance": {"$ref": "#/$defs/builderProvenance"}, "revision_context": {"$ref": "#/$defs/revisionContext"}},
  "allOf": [
    {
      "if": {"properties": {"trigger": {"const": "initial_step"}}},
      "then": {
        "properties": {
          "step_id": {"const": "0"},
          "project_context": {"properties": {"binding_mode": {"const": "project_intake"}}},
          "sources": {
            "allOf": [
              {"contains": {"properties": {"source_kind": {"const": "project_intake"}}, "required": ["source_kind"]}, "minContains": 1, "maxContains": 1},
              {"not": {"contains": {"properties": {"source_kind": {"enum": ["project_v2", "released_predecessor", "rejected_artifact", "revision_request", "operator_instruction"]}}, "required": ["source_kind"]}}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"trigger": {"const": "next_step"}}},
      "then": {
        "properties": {
          "step_id": {"not": {"const": "0"}},
          "project_context": {"properties": {"binding_mode": {"const": "project_v2"}}},
          "sources": {"allOf": [{"contains": {"properties": {"source_kind": {"const": "project_v2"}}, "required": ["source_kind"]}, "minContains": 1, "maxContains": 1}, {"contains": {"properties": {"source_kind": {"const": "released_predecessor"}}, "required": ["source_kind"]}}, {"not": {"contains": {"properties": {"source_kind": {"enum": ["project_intake", "rejected_artifact", "revision_request", "operator_instruction"]}}, "required": ["source_kind"]}}}]}
        }
      }
    },
    {
      "if": {"properties": {"trigger": {"const": "revision"}}},
      "then": {
        "required": ["revision_context"],
        "properties": {
          "sources": {
            "allOf": [
               {"contains": {"properties": {"source_kind": {"const": "rejected_artifact"}}, "required": ["source_kind"]}, "minContains": 1},
               {"contains": {"properties": {"source_kind": {"const": "revision_request"}}, "required": ["source_kind"]}, "minContains": 1, "maxContains": 1},
               {"contains": {"properties": {"source_kind": {"const": "operator_instruction"}}, "required": ["source_kind"]}, "minContains": 1, "maxContains": 1},
               {"contains": {"properties": {"source_kind": {"const": "quality_gate_run"}}, "required": ["source_kind"]}}
            ]
          }
        }
      }
    },
    {"if": {"properties": {"trigger": {"const": "revision"}, "step_id": {"const": "0"}}, "required": ["trigger", "step_id"]}, "then": {"properties": {"project_context": {"properties": {"binding_mode": {"const": "project_intake"}}}, "sources": {"allOf": [{"contains": {"properties": {"source_kind": {"const": "project_intake"}}, "required": ["source_kind"]}, "minContains": 1, "maxContains": 1}, {"not": {"contains": {"properties": {"source_kind": {"enum": ["project_v2", "released_predecessor"]}}, "required": ["source_kind"]}}}]}}}},
    {"if": {"properties": {"trigger": {"const": "revision"}, "step_id": {"not": {"const": "0"}}}, "required": ["trigger", "step_id"]}, "then": {"properties": {"project_context": {"properties": {"binding_mode": {"const": "project_v2"}}}, "sources": {"allOf": [{"contains": {"properties": {"source_kind": {"const": "project_v2"}}, "required": ["source_kind"]}, "minContains": 1, "maxContains": 1}, {"contains": {"properties": {"source_kind": {"const": "released_predecessor"}}, "required": ["source_kind"]}, "minContains": 1}]}}}},
    {"if": {"properties": {"step_id": {"enum": ["1c", "4a", "4b"]}}}, "then": {"properties": {"output_contracts": {"minItems": 2}}}},
    {"if": {"properties": {"trigger": {"enum": ["retry", "resume"]}}}, "then": {"properties": {"project_context": {"properties": {"binding_mode": {"const": "project_v2"}}}, "sources": {"not": {"contains": {"properties": {"source_kind": {"enum": ["rejected_artifact", "revision_request", "operator_instruction"]}}, "required": ["source_kind"]}}}}}},
    {"not": {"properties": {"sources": {"contains": {"properties": {"source_status": {"const": "superseded"}}, "required": ["source_status"]}}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "tenantId": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "projectId": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "step": {"enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "logicalRef": {"type": "string", "pattern": "^(?:runtime|operator|prompt|output-contract):[a-z0-9][a-z0-9_-]*(?:/[a-z0-9][a-z0-9_-]*)*$"},
    "prompt": {"type": "object", "additionalProperties": false, "required": ["prompt_id", "prompt_version", "prompt_path", "prompt_sha256"], "properties": {"prompt_id": {"type": "string", "pattern": "^heartweb\\.step\\.(?:0|1|1b|1c|2|3|3b|4a|4b)$"}, "prompt_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "prompt_path": {"type": "string", "pattern": "^prompts/[a-z0-9][a-z0-9.-]*\\.xml\\.md$"}, "prompt_sha256": {"$ref": "#/$defs/sha256"}}},
    "projectContext": {"type": "object", "additionalProperties": false, "required": ["binding_mode", "source_id", "revision", "logical_ref", "content_sha256"], "properties": {"binding_mode": {"enum": ["project_intake", "project_v2"]}, "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "revision": {"type": "integer", "minimum": 1}, "logical_ref": {"$ref": "#/$defs/logicalRef"}, "content_sha256": {"$ref": "#/$defs/sha256"}}},
    "workerProfileRef": {"type": "object", "additionalProperties": false, "required": ["worker_profile_id", "profile_version", "profile_sha256"], "properties": {"worker_profile_id": {"type": "string", "pattern": "^worker-profile-[a-z0-9][a-z0-9-]{2,63}$"}, "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "profile_sha256": {"$ref": "#/$defs/sha256"}}},
    "outputContract": {"type": "object", "additionalProperties": false, "required": ["contract_id", "contract_version", "contract_path", "contract_sha256"], "properties": {"contract_id": {"type": "string", "pattern": "^https://heartweb\\.example/schema/(?:outputs/)?[a-z0-9][a-z0-9./-]*\\.schema\\.json$"}, "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "contract_path": {"type": "string", "pattern": "^standards/(?:outputs/)?[a-z0-9][a-z0-9./-]*\\.schema\\.json$"}, "contract_sha256": {"$ref": "#/$defs/sha256"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["include_order", "source_kind", "source_id", "tenant_id", "project_id", "revision", "logical_ref", "content_sha256", "source_status", "trust_level"], "properties": {"include_order": {"type": "integer", "minimum": 1}, "source_kind": {"enum": ["project_intake", "project_v2", "official_prompt", "output_contract", "released_predecessor", "released_supporting_artifact", "rejected_artifact", "evidence", "decision", "quality_gate_run", "revision_request", "operator_instruction", "blocker", "resolution"]}, "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "tenant_id": {"$ref": "#/$defs/tenantId"}, "project_id": {"$ref": "#/$defs/projectId"}, "revision": {"type": "integer", "minimum": 1}, "logical_ref": {"$ref": "#/$defs/logicalRef"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "source_status": {"enum": ["active", "released", "rejected", "superseded", "historical"]}, "trust_level": {"enum": ["trusted", "operator_asserted", "untrusted", "not_applicable"]}, "untrusted_reason": {"type": "string", "minLength": 1}, "permitted_use": {"enum": ["reference_data", "comparison_only"]}}, "allOf": [{"if": {"properties": {"trust_level": {"const": "untrusted"}}, "required": ["trust_level"]}, "then": {"properties": {"source_kind": {"enum": ["evidence", "project_intake"]}}}}, {"if": {"properties": {"source_kind": {"const": "evidence"}, "trust_level": {"const": "untrusted"}}, "required": ["source_kind", "trust_level"]}, "then": {"required": ["untrusted_reason", "permitted_use"]}}, {"if": {"properties": {"source_kind": {"not": {"enum": ["evidence", "project_intake"]}}}, "required": ["source_kind"]}, "then": {"properties": {"trust_level": {"not": {"const": "untrusted"}}}}}]},
    "builderProvenance": {"type": "object", "additionalProperties": false, "required": ["builder_version", "created_at", "created_by"], "properties": {"builder_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "created_at": {"type": "string", "format": "date-time"}, "created_by": {"type": "string", "minLength": 1}}},
    "revisionContext": {"type": "object", "additionalProperties": false, "required": ["revision_request_id", "rejected_artifact_revision", "expected_new_revision", "finding_logical_ref"], "properties": {"revision_request_id": {"type": "string", "pattern": "^revision-[a-z0-9][a-z0-9-]{7,63}$"}, "rejected_artifact_revision": {"type": "integer", "minimum": 1}, "expected_new_revision": {"type": "integer", "minimum": 2}, "finding_logical_ref": {"$ref": "#/$defs/logicalRef"}}}
  }
}
