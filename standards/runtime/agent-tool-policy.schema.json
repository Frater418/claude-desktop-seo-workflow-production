{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/runtime/agent-tool-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool_policy_id",
    "schema_version",
    "policy_version",
    "policy_sha256",
    "step_id",
    "allowed_gateway_operations",
    "required_gateway_operations",
    "delegation_policy",
    "direct_provider_calls_allowed",
    "failure_mode",
    "enabled",
    "created_at"
  ],
  "properties": {
    "tool_policy_id": {"type": "string", "pattern": "^tool-policy-step-(?:0|1|1b|1c|2|3|4a|4b)-agent$"},
    "schema_version": {"const": "1.0.0"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "policy_sha256": {"$ref": "#/$defs/sha256"},
    "step_id": {"$ref": "#/$defs/step"},
    "allowed_gateway_operations": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/gatewayOperation"}
    },
    "required_gateway_operations": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 16,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"}
    },
    "delegation_policy": {"$ref": "#/$defs/delegationPolicy"},
    "direct_provider_calls_allowed": {"const": false},
    "failure_mode": {"const": "fail_closed"},
    "enabled": {"type": "boolean"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "step": {"enum": ["0", "1", "1b", "1c", "2", "3", "4a", "4b"]},
    "gatewayOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "tool_name",
        "phase",
        "side_effect",
        "confirmation_scope",
        "cost_mode",
        "max_calls",
        "timeout_seconds",
        "evidence_required"
      ],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
        "tool_name": {"type": "string", "pattern": "^mcp__heartweb__[a-z][a-z0-9_]{2,63}$"},
        "phase": {"enum": ["preflight", "production", "validation", "review"]},
        "side_effect": {"enum": ["read_only", "local_evidence_write", "external_read", "external_write"]},
        "provider_id": {"type": "string", "pattern": "^provider-[a-z0-9][a-z0-9-]{2,63}$"},
        "confirmation_scope": {"enum": ["none", "step_run", "exact_request"]},
        "cost_mode": {"enum": ["none", "bounded", "unknown_blocked", "provider_credits_unreported"]},
        "max_cost_usd": {"type": "number", "minimum": 0},
        "max_calls": {"type": "integer", "minimum": 1, "maximum": 20},
        "max_items": {"type": "integer", "minimum": 1, "maximum": 1000},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "evidence_required": {"type": "boolean"},
        "input_contract_id": {"type": "string", "minLength": 1},
        "output_contract_id": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"cost_mode": {"const": "bounded"}}, "required": ["cost_mode"]},
          "then": {"required": ["max_cost_usd"]}
        },
        {
          "if": {"properties": {"cost_mode": {"enum": ["unknown_blocked", "provider_credits_unreported"]}}, "required": ["cost_mode"]},
          "then": {"properties": {"confirmation_scope": {"const": "exact_request"}}}
        }
      ]
    },
    "delegationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delegation_policy_id", "allowed", "max_workers", "max_depth", "max_rounds", "allowed_purposes", "external_side_effects_allowed"],
      "properties": {
        "delegation_policy_id": {"type": "string", "pattern": "^delegation-policy-step-(?:0|1|1b|1c|2|3|4a|4b)-v[0-9]+$"},
        "allowed": {"type": "boolean"},
        "max_workers": {"type": "integer", "minimum": 0, "maximum": 2},
        "max_depth": {"type": "integer", "minimum": 0, "maximum": 1},
        "max_rounds": {"type": "integer", "minimum": 0, "maximum": 1},
        "allowed_purposes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["research", "processing", "synthesis", "domain_review"]}
        },
        "external_side_effects_allowed": {"const": false}
      },
      "allOf": [
        {
          "if": {"properties": {"allowed": {"const": false}}, "required": ["allowed"]},
          "then": {
            "properties": {
              "max_workers": {"const": 0},
              "max_depth": {"const": 0},
              "max_rounds": {"const": 0},
              "allowed_purposes": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"allowed": {"const": true}}, "required": ["allowed"]},
          "then": {
            "properties": {
              "max_workers": {"minimum": 1},
              "max_depth": {"const": 1},
              "max_rounds": {"const": 1},
              "allowed_purposes": {"minItems": 1}
            }
          }
        }
      ]
    }
  }
}
