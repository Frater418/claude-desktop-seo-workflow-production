{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/runtime/llm-run-request.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["llm_run_request_id", "schema_version", "tenant_id", "project_id", "run_id", "step_id", "target_revision", "correlation_id", "idempotency_key", "run_mode", "logical_session_id", "logical_session_revision", "context_package_id", "context_package_sha256", "worker_profile_id", "worker_profile_version", "worker_profile_sha256", "provider_id", "model_id", "tool_policy_id", "tool_policy_version", "tool_policy_sha256", "input_sha256", "output_contracts", "dispatch_policy", "requested_at"],
  "properties": {"llm_run_request_id": {"type": "string", "pattern": "^llm-request-[a-z0-9][a-z0-9-]{7,63}$"}, "schema_version": {"const": "1.0.0"}, "tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "step_id": {"$ref": "#/$defs/step"}, "target_revision": {"type": "integer", "minimum": 1}, "correlation_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"}, "idempotency_key": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,127}$"}, "run_mode": {"enum": ["initial_step", "next_step", "revision", "retry", "resume"]}, "logical_session_id": {"type": "string", "pattern": "^logical-session-[a-z0-9][a-z0-9-]{7,63}$"}, "logical_session_revision": {"type": "integer", "minimum": 1}, "context_package_id": {"type": "string", "pattern": "^context-[a-z0-9][a-z0-9-]{7,63}$"}, "context_package_sha256": {"$ref": "#/$defs/sha256"}, "worker_profile_id": {"type": "string", "pattern": "^worker-profile-[a-z0-9][a-z0-9-]{2,63}$"}, "worker_profile_version": {"$ref": "#/$defs/semver"}, "worker_profile_sha256": {"$ref": "#/$defs/sha256"}, "provider_id": {"type": "string", "pattern": "^provider-[a-z0-9][a-z0-9-]{2,63}$"}, "model_id": {"type": "string", "pattern": "^model-[a-z0-9][a-z0-9-]{2,63}$"}, "tool_policy_id": {"type": "string", "pattern": "^tool-policy-[a-z0-9][a-z0-9-]{2,63}$"}, "tool_policy_version": {"$ref": "#/$defs/semver"}, "tool_policy_sha256": {"$ref": "#/$defs/sha256"}, "input_sha256": {"$ref": "#/$defs/sha256"}, "output_contracts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/outputContract"}}, "dispatch_policy": {"$ref": "#/$defs/dispatchPolicy"}, "technical_session_cache_hint": {"$ref": "#/$defs/cacheHint"}, "requested_at": {"type": "string", "format": "date-time"}},
  "allOf": [
    {"if": {"properties": {"run_mode": {"enum": ["initial_step", "next_step", "revision"]}}}, "then": {"properties": {"dispatch_policy": {"properties": {"execution": {"const": "fresh"}, "technical_session_reuse": {"const": "forbidden"}}}}, "not": {"required": ["technical_session_cache_hint"]}}},
    {"if": {"properties": {"dispatch_policy": {"properties": {"technical_session_reuse": {"const": "cache_hint"}}}}}, "then": {"required": ["technical_session_cache_hint"]}},
    {"if": {"properties": {"dispatch_policy": {"properties": {"technical_session_reuse": {"const": "forbidden"}}}}}, "then": {"not": {"required": ["technical_session_cache_hint"]}}}
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "step": {"enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "outputContract": {"type": "object", "additionalProperties": false, "required": ["contract_id", "contract_version", "contract_path", "contract_sha256"], "properties": {"contract_id": {"type": "string", "pattern": "^https://heartweb\\.example/schema/(?:outputs/)?[a-z0-9][a-z0-9./-]*\\.schema\\.json$"}, "contract_version": {"$ref": "#/$defs/semver"}, "contract_path": {"type": "string", "pattern": "^standards/(?:outputs/)?[a-z0-9][a-z0-9./-]*\\.schema\\.json$"}, "contract_sha256": {"$ref": "#/$defs/sha256"}}}, "dispatchPolicy": {"type": "object", "additionalProperties": false, "required": ["execution", "technical_session_reuse"], "properties": {"execution": {"enum": ["fresh", "fresh_or_reuse_after_validation"]}, "technical_session_reuse": {"enum": ["forbidden", "cache_hint"]}}}, "cacheHint": {"type": "object", "additionalProperties": false, "required": ["provider_id", "cache_hint_hash", "observed_at", "session_state"], "properties": {"provider_id": {"type": "string", "pattern": "^provider-[a-z0-9][a-z0-9-]{2,63}$"}, "cache_hint_hash": {"$ref": "#/$defs/sha256"}, "observed_at": {"type": "string", "format": "date-time"}, "session_state": {"enum": ["available", "missing", "expired", "invalid"]}}}}
}
