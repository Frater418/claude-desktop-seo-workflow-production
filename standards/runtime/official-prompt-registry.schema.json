{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/runtime/official-prompt-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {"schema_version": {"const": "1.0.0"}, "entries": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/entry"}}},
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "step": {"enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]},
    "outputContract": {"type": "object", "additionalProperties": false, "required": ["contract_id", "contract_version", "contract_path", "contract_sha256"], "properties": {"contract_id": {"type": "string", "pattern": "^https://heartweb\\.example/schema/(?:outputs/)?[a-z0-9][a-z0-9./-]*\\.schema\\.json$"}, "contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "contract_path": {"type": "string", "pattern": "^standards/(?:outputs/)?[a-z0-9][a-z0-9./-]*\\.schema\\.json$"}, "contract_sha256": {"$ref": "#/$defs/sha256"}}},
    "entry": {"type": "object", "additionalProperties": false, "required": ["step_id", "prompt_id", "prompt_version", "prompt_path", "prompt_sha256", "output_contracts", "active"], "properties": {"step_id": {"$ref": "#/$defs/step"}, "prompt_id": {"type": "string", "pattern": "^heartweb\\.step\\.(?:0|1|1b|1c|2|3|3b|4a|4b)$"}, "prompt_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "prompt_path": {"type": "string", "pattern": "^prompts/[a-z0-9][a-z0-9.-]*\\.xml\\.md$"}, "prompt_sha256": {"$ref": "#/$defs/sha256"}, "output_contracts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/outputContract"}}, "active": {"type": "boolean"}}}
  }
}
