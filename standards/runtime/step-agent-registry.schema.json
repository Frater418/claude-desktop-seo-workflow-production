{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/runtime/step-agent-registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "schema_version", "registry_version", "registry_sha256", "entries", "created_at"],
  "properties": {
    "registry_id": {"const": "heartweb-step-agent-registry"},
    "schema_version": {"const": "1.0.0"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "entries": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/entry"}
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "step": {"enum": ["0", "1", "1b", "1c", "2", "3", "4a", "4b"]},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "agent_contract_id",
        "agent_contract_version",
        "worker_profile_path",
        "worker_profile_id",
        "worker_profile_version",
        "worker_profile_sha256",
        "tool_policy_path",
        "tool_policy_id",
        "tool_policy_version",
        "tool_policy_sha256",
        "active"
      ],
      "properties": {
        "step_id": {"$ref": "#/$defs/step"},
        "agent_contract_id": {"type": "string", "pattern": "^heartweb-step-(?:0|1|1b|1c|2|3|4a|4b)-agent$"},
        "agent_contract_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "worker_profile_path": {"type": "string", "pattern": "^standards/runtime/worker-profiles/[a-z0-9-]+\\.json$"},
        "worker_profile_id": {"type": "string", "pattern": "^worker-profile-[a-z0-9][a-z0-9-]{2,63}$"},
        "worker_profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "worker_profile_sha256": {"$ref": "#/$defs/sha256"},
        "tool_policy_path": {"type": "string", "pattern": "^standards/runtime/tool-policies/[a-z0-9-]+\\.json$"},
        "tool_policy_id": {"type": "string", "pattern": "^tool-policy-step-(?:0|1|1b|1c|2|3|4a|4b)-agent$"},
        "tool_policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "tool_policy_sha256": {"$ref": "#/$defs/sha256"},
        "active": {"type": "boolean"}
      }
    }
  }
}
