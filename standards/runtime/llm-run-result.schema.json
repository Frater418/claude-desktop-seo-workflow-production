{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/runtime/llm-run-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["llm_run_result_id", "schema_version", "llm_run_request_id", "tenant_id", "project_id", "run_id", "step_id", "target_revision", "context_package_id", "context_package_sha256", "worker_profile_id", "worker_profile_version", "worker_profile_sha256", "provider_id", "model_id", "tool_policy_id", "tool_policy_version", "tool_policy_sha256", "status", "started_at", "finished_at", "input_sha256", "result_sha256", "token_usage"],
  "properties": {
    "llm_run_result_id": {"type": "string", "pattern": "^llm-result-[a-z0-9][a-z0-9-]{7,63}$"}, "schema_version": {"const": "1.0.0"}, "llm_run_request_id": {"type": "string", "pattern": "^llm-request-[a-z0-9][a-z0-9-]{7,63}$"}, "tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "step_id": {"enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "target_revision": {"type": "integer", "minimum": 1}, "context_package_id": {"type": "string", "pattern": "^context-[a-z0-9][a-z0-9-]{7,63}$"}, "context_package_sha256": {"$ref": "#/$defs/sha256"}, "worker_profile_id": {"type": "string", "pattern": "^worker-profile-[a-z0-9][a-z0-9-]{2,63}$"}, "worker_profile_version": {"$ref": "#/$defs/semver"}, "worker_profile_sha256": {"$ref": "#/$defs/sha256"}, "provider_id": {"type": "string", "pattern": "^provider-[a-z0-9][a-z0-9-]{2,63}$"}, "model_id": {"type": "string", "pattern": "^model-[a-z0-9][a-z0-9-]{2,63}$"}, "tool_policy_id": {"type": "string", "pattern": "^tool-policy-[a-z0-9][a-z0-9-]{2,63}$"}, "tool_policy_version": {"$ref": "#/$defs/semver"}, "tool_policy_sha256": {"$ref": "#/$defs/sha256"}, "status": {"enum": ["succeeded", "failed", "cancelled"]}, "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"}, "input_sha256": {"$ref": "#/$defs/sha256"}, "result_sha256": {"$ref": "#/$defs/sha256"}, "token_usage": {"$ref": "#/$defs/tokenUsage"}, "output": {"$ref": "#/$defs/output"}, "error": {"$ref": "#/$defs/error"}, "technical_session_observation": {"enum": ["not_used", "reused", "missing", "expired", "invalid"]}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "succeeded"}}}, "then": {"required": ["output"], "not": {"required": ["error"]}}}, {"if": {"properties": {"status": {"enum": ["failed", "cancelled"]}}}, "then": {"required": ["error"], "not": {"required": ["output"]}}}],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "logicalRef": {"type": "string", "pattern": "^(?:runtime|operator|prompt|output-contract):[a-z0-9][a-z0-9_-]*(?:/[a-z0-9][a-z0-9_-]*)*$"}, "tokenUsage": {"type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "total_tokens"], "properties": {"input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}, "cached_input_tokens": {"type": "integer", "minimum": 0}}}, "output": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "revision", "content_sha256", "logical_ref"], "properties": {"artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "revision": {"type": "integer", "minimum": 1}, "content_sha256": {"$ref": "#/$defs/sha256"}, "logical_ref": {"$ref": "#/$defs/logicalRef"}}}, "error": {"type": "object", "additionalProperties": false, "required": ["error_class", "message", "retry_class", "occurred_at"], "properties": {"error_class": {"enum": ["provider", "tool", "context_validation", "policy", "storage", "cancelled"]}, "message": {"type": "string", "minLength": 1}, "retry_class": {"enum": ["never", "retryable", "manual"]}, "occurred_at": {"type": "string", "format": "date-time"}, "provider_error_code": {"type": "string", "pattern": "^[A-Z0-9_]{2,64}$"}}}
  }
}
