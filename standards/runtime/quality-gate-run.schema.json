{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/runtime/quality-gate-run.schema.json",
  "title": "Heartweb Quality Gate Run", "type": "object", "additionalProperties": false,
  "required": ["quality_gate_run_id", "quality_gate_id", "human_gate_id", "tenant_id", "run_id", "step_id", "artifact_id", "artifact_sha256", "registry_version", "policy_version", "result", "evidence", "checked_at", "checker_version"],
  "properties": {
    "quality_gate_run_id": {"type": "string", "pattern": "^qgr-[a-z0-9][a-z0-9-]{7,63}$"}, "quality_gate_id": {"type": "string", "pattern": "^qg-[a-z0-9][a-z0-9-]{2,127}$"}, "human_gate_id": {"type": "string", "pattern": "^GATE-(0|1|1B|1C|2|3|3B|4A|4B)$"}, "tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"},
    "step_id": {"type": "string", "enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "artifact_revision": {"type": "integer", "minimum": 1},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "result": {"type": "string", "enum": ["passed", "failed", "blocked"]}, "evidence": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["string", "number", "integer", "boolean"]}}, "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}, "waiver_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^waiver-[a-z0-9][a-z0-9-]{7,63}$"}}, "checked_at": {"type": "string", "format": "date-time"}, "checker_version": {"type": "string", "minLength": 1}
  }, "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "finding": {"type": "object", "additionalProperties": false, "required": ["code", "severity", "message"], "properties": {"code": {"type": "string", "pattern": "^QG_[A-Z0-9_]+$"}, "severity": {"type": "string", "enum": ["info", "warning", "error"]}, "message": {"type": "string", "minLength": 1}}}}
}
