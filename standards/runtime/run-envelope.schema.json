{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/runtime/run-envelope.schema.json",
  "title": "Heartweb Run Envelope", "type": "object", "additionalProperties": false,
  "required": ["run_id", "tenant_id", "project_id", "step_id", "gate_id", "revision", "status", "input_hash", "idempotency_key", "attempt", "created_at"],
  "properties": {
    "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"},
    "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "step_id": {"type": "string", "enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]},
    "gate_id": {"type": "string", "pattern": "^GATE-(0|1|1B|1C|2|3|3B|4A|4B)$"}, "revision": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["pending", "in_progress", "awaiting_gate", "approved", "completed", "failed", "superseded"]},
    "input_hash": {"$ref": "#/$defs/sha256"}, "output_hash": {"$ref": "#/$defs/sha256"}, "idempotency_key": {"type": "string", "pattern": "^idem-[a-z0-9][a-z0-9-]{7,127}$"},
    "attempt": {"type": "integer", "minimum": 1}, "supersedes_run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
