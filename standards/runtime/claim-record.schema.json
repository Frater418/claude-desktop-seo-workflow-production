{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/runtime/claim-record.schema.json",
  "title": "Heartweb Claim Record", "type": "object", "additionalProperties": false,
  "required": ["claim_id", "tenant_id", "artifact_id", "claim_type", "text", "policy_version", "reviewer_policy", "evidence_ids", "approval_status"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^claim-[a-z0-9][a-z0-9-]{7,63}$"}, "tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"},
    "claim_type": {"type": "string", "enum": ["factual", "medical", "financial", "legal", "local_presence", "testimonial"]}, "text": {"type": "string", "minLength": 1}, "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "reviewer_policy": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{7,63}$"}}, "reviewer_id": {"type": "string", "pattern": "^reviewer-[a-z0-9][a-z0-9-]{2,63}$"}, "approval_status": {"type": "string", "enum": ["pending", "approved", "rejected"]}
  },
  "allOf": [{"if": {"properties": {"approval_status": {"const": "approved"}}}, "then": {"required": ["reviewer_id"]}}]
}
