{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://heartweb.example/schema/outputs/step-3b-adjustment.schema.json", "title": "Heartweb Step 3B Immutable Adjustment Candidate", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "run_id", "project_id", "step_id", "revision", "source_artifact_ids", "evidence_ids", "decision_records", "candidate_status", "source_plan", "original_plan_action", "proposed_plan"],
  "properties": {"schema_version": {"const": "2.0.0"}, "artifact_id": {"$ref": "#/$defs/artifactId"}, "run_id": {"$ref": "#/$defs/runId"}, "project_id": {"$ref": "#/$defs/projectId"}, "step_id": {"const": "3b"}, "revision": {"type": "integer", "minimum": 1}, "source_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactId"}}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceId"}}, "decision_records": {"type": "array", "items": {"$ref": "#/$defs/decision"}}, "candidate_status": {"const": "awaiting_gate"}, "source_plan": {"$ref": "#/$defs/sourcePlan"}, "original_plan_action": {"const": "reference_only"}, "proposed_plan": {"$ref": "#/$defs/proposedPlan"}},
  "$defs": {"artifactId": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "runId": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "projectId": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "evidenceId": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{7,63}$"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "decision": {"type": "object", "additionalProperties": false, "required": ["decision_id", "decision", "evidence_ids"], "properties": {"decision_id": {"type": "string", "pattern": "^decision-[a-z0-9][a-z0-9-]{7,63}$"}, "decision": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidenceId"}}}}, "sourcePlan": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "revision", "content_sha256", "step_id", "status"], "properties": {"artifact_id": {"$ref": "#/$defs/artifactId"}, "revision": {"type": "integer", "minimum": 1}, "content_sha256": {"$ref": "#/$defs/hash"}, "step_id": {"const": "3"}, "status": {"const": "released"}}}, "proposedPlan": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "revision", "content_sha256", "supersedes_source_plan"], "properties": {"artifact_id": {"$ref": "#/$defs/artifactId"}, "revision": {"type": "integer", "minimum": 1}, "content_sha256": {"$ref": "#/$defs/hash"}, "supersedes_source_plan": {"const": true}}}}
}
