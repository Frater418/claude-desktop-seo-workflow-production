{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/outputs/step-1c-template.schema.json",
  "title": "Heartweb Step 1C Canonical Template V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "run_id", "project_id", "deployment_id", "step_id", "revision", "source_artifact_ids", "evidence_ids", "decision_records", "candidate_status", "template_family", "template_id", "content_id", "location_context", "accessibility", "jsonld_references", "links", "content"],
  "properties": {"schema_version": {"const": "2.0.0"}, "artifact_id": {"$ref": "#/$defs/artifactId"}, "run_id": {"$ref": "#/$defs/runId"}, "project_id": {"$ref": "#/$defs/projectId"}, "deployment_id": {"$ref": "#/$defs/deploymentId"}, "step_id": {"const": "1c"}, "revision": {"type": "integer", "minimum": 1}, "source_artifact_ids": {"$ref": "#/$defs/artifactIds"}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}, "decision_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decisionRecord"}}, "candidate_status": {"const": "awaiting_gate"}, "template_family": {"const": "pillar-page"}, "template_id": {"type": "string", "pattern": "^template-[a-z0-9][a-z0-9-]{2,63}$"}, "content_id": {"type": "string", "pattern": "^pillar-[a-z0-9][a-z0-9-]{2,63}$"}, "location_context": {"$ref": "#/$defs/locationContext"}, "accessibility": {"$ref": "#/$defs/accessibility"}, "jsonld_references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/jsonLd"}}, "links": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/link"}}, "content": {"$ref": "#/$defs/content"}},
  "$defs": {
    "artifactId": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "runId": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "projectId": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "deploymentId": {"type": "string", "pattern": "^dep-[a-z0-9][a-z0-9-]{2,63}$"}, "evidenceId": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{7,63}$"}, "artifactIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactId"}}, "evidenceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceId"}},
    "decisionRecord": {"type": "object", "additionalProperties": false, "required": ["decision_id", "question", "outcome", "evidence_ids"], "properties": {"decision_id": {"type": "string", "pattern": "^decision-[a-z0-9][a-z0-9-]{2,63}$"}, "question": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "minLength": 1}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}},
    "locationContext": {"type": "object", "additionalProperties": false, "required": ["claim_type", "evidence_ids"], "properties": {"claim_type": {"enum": ["service_area", "physical_location"]}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}, "physical_location_evidence_ids": {"$ref": "#/$defs/evidenceIds"}, "physical_address": {"type": "string", "minLength": 1}, "nap": {"type": "string", "minLength": 1}, "gbp_claim": {"type": "string", "minLength": 1}}, "allOf": [{"if": {"properties": {"claim_type": {"const": "physical_location"}}}, "then": {"required": ["physical_location_evidence_ids", "physical_address"]}}]},
    "accessibility": {"type": "object", "additionalProperties": false, "required": ["landmarks", "skip_link", "skip_link_label"], "properties": {"landmarks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["main", "nav", "header", "footer"]}}, "skip_link": {"const": true}, "skip_link_label": {"$ref": "#/$defs/text"}}},
    "jsonLd": {"type": "object", "additionalProperties": false, "required": ["reference_id", "type", "evidence_ids"], "properties": {"reference_id": {"type": "string", "pattern": "^jsonld-[a-z0-9][a-z0-9-]{2,63}$"}, "type": {"enum": ["FAQPage", "Service", "LocalBusiness"]}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}},
    "link": {"type": "object", "additionalProperties": false, "required": ["target_content_id", "relationship", "href"], "properties": {"target_content_id": {"type": "string", "pattern": "^(pillar|cluster)-[a-z0-9][a-z0-9-]{2,63}$"}, "relationship": {"enum": ["vertical", "horizontal"]}, "href": {"type": "string", "pattern": "^/[a-z0-9][a-z0-9-]*(?:/[a-z0-9][a-z0-9-]*)*/?$", "not": {"pattern": "\\s"}}}},
    "text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "contentLink": {"type": "object", "additionalProperties": false, "required": ["label", "target_content_id", "relationship"], "properties": {"label": {"$ref": "#/$defs/text"}, "target_content_id": {"type": "string", "pattern": "^(pillar|cluster)-[a-z0-9][a-z0-9-]{2,63}$"}, "relationship": {"enum": ["vertical", "horizontal"]}}},
    "cta": {"type": "object", "additionalProperties": false, "required": ["label", "target_content_id", "evidence_ids"], "properties": {"label": {"$ref": "#/$defs/text"}, "target_content_id": {"type": "string", "pattern": "^cluster-[a-z0-9][a-z0-9-]{2,63}$"}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}},
    "fact": {"type": "object", "additionalProperties": false, "required": ["label", "value", "evidence_ids"], "properties": {"label": {"$ref": "#/$defs/text"}, "value": {"$ref": "#/$defs/text"}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}},
    "processStep": {"type": "object", "additionalProperties": false, "required": ["title", "description", "evidence_ids"], "properties": {"title": {"$ref": "#/$defs/text"}, "description": {"$ref": "#/$defs/text"}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}},
    "socialProof": {"type": "object", "additionalProperties": false, "required": ["quote", "attribution", "evidence_ids"], "properties": {"quote": {"$ref": "#/$defs/text"}, "attribution": {"$ref": "#/$defs/text"}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}},
    "faqItem": {"type": "object", "additionalProperties": false, "required": ["question", "answer", "jsonld_reference_id", "evidence_ids"], "properties": {"question": {"$ref": "#/$defs/text"}, "answer": {"$ref": "#/$defs/text"}, "jsonld_reference_id": {"type": "string", "pattern": "^jsonld-[a-z0-9][a-z0-9-]{2,63}$"}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}},
    "content": {"type": "object", "additionalProperties": false, "required": ["hero", "quick_facts", "editorial", "heartpiece", "grouped_cluster_links", "process", "social_proof", "faq", "cross_pillar_links", "final_cta"], "properties": {"hero": {"type": "object", "additionalProperties": false, "required": ["heading", "summary", "primary_cta"], "properties": {"heading": {"$ref": "#/$defs/text"}, "summary": {"$ref": "#/$defs/text"}, "primary_cta": {"$ref": "#/$defs/cta"}}}, "quick_facts": {"type": "object", "additionalProperties": false, "required": ["heading", "facts"], "properties": {"heading": {"$ref": "#/$defs/text"}, "facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}}}}, "editorial": {"type": "object", "additionalProperties": false, "required": ["heading", "paragraphs", "evidence_ids"], "properties": {"heading": {"$ref": "#/$defs/text"}, "paragraphs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}}, "heartpiece": {"type": "object", "additionalProperties": false, "required": ["heading", "body", "evidence_ids"], "properties": {"heading": {"$ref": "#/$defs/text"}, "body": {"$ref": "#/$defs/text"}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}}, "grouped_cluster_links": {"type": "object", "additionalProperties": false, "required": ["heading", "groups"], "properties": {"heading": {"$ref": "#/$defs/text"}, "groups": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["label", "links"], "properties": {"label": {"$ref": "#/$defs/text"}, "links": {"type": "array", "minItems": 1, "items": {"allOf": [{"$ref": "#/$defs/contentLink"}, {"properties": {"target_content_id": {"pattern": "^cluster-[a-z0-9][a-z0-9-]{2,63}$"}, "relationship": {"const": "vertical"}}}]}}}}}}}, "process": {"type": "object", "additionalProperties": false, "required": ["heading", "steps"], "properties": {"heading": {"$ref": "#/$defs/text"}, "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/processStep"}}}}, "social_proof": {"type": "object", "additionalProperties": false, "required": ["heading", "entries"], "properties": {"heading": {"$ref": "#/$defs/text"}, "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/socialProof"}}}}, "faq": {"type": "object", "additionalProperties": false, "required": ["heading", "items"], "properties": {"heading": {"$ref": "#/$defs/text"}, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/faqItem"}}}}, "cross_pillar_links": {"type": "object", "additionalProperties": false, "required": ["heading", "links"], "properties": {"heading": {"$ref": "#/$defs/text"}, "links": {"type": "array", "items": {"allOf": [{"$ref": "#/$defs/contentLink"}, {"properties": {"target_content_id": {"pattern": "^pillar-[a-z0-9][a-z0-9-]{2,63}$"}, "relationship": {"const": "horizontal"}}}]}}}}, "final_cta": {"type": "object", "additionalProperties": false, "required": ["heading", "summary", "primary_cta"], "properties": {"heading": {"$ref": "#/$defs/text"}, "summary": {"$ref": "#/$defs/text"}, "primary_cta": {"$ref": "#/$defs/cta"}}}}}
  }
}
