{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/outputs/step-2-keyword-evidence.schema.json",
  "title": "Heartweb Step 2 Keyword Evidence V2",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "run_id", "project_id", "step_id", "deployment_id", "revision", "source_artifact_ids", "evidence_ids", "decision_records", "candidate_status", "language", "geo", "pillars"],
  "properties": {"schema_version": {"const": "2.0.0"}, "artifact_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "project_id": {"$ref": "#/$defs/id"}, "step_id": {"const": "2"}, "deployment_id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1}, "source_artifact_ids": {"$ref": "#/$defs/ids"}, "evidence_ids": {"$ref": "#/$defs/ids"}, "decision_records": {"type": "array", "items": {"$ref": "#/$defs/decision"}}, "candidate_status": {"const": "awaiting_gate"}, "language": {"type": "string", "pattern": "^[a-z]{2,3}$"}, "geo": {"$ref": "#/$defs/geo"}, "pillars": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pillar"}}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{7,63}$"}, "ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "geo": {"type": "object", "additionalProperties": false, "required": ["country_code", "provider_location_code"], "properties": {"country_code": {"type": "string", "pattern": "^[A-Z]{2}$"}, "provider_location_code": {"type": "integer", "minimum": 1}}}, "decision": {"type": "object", "additionalProperties": false, "required": ["decision_id", "outcome", "evidence_ids"], "properties": {"decision_id": {"$ref": "#/$defs/id"}, "outcome": {"type": "string", "minLength": 1}, "evidence_ids": {"$ref": "#/$defs/ids"}}}, "pillar": {"type": "object", "additionalProperties": false, "required": ["pillar_id", "status", "rows"], "properties": {"pillar_id": {"$ref": "#/$defs/id"}, "status": {"const": "approved"}, "rows": {"type": "array", "minItems": 25, "items": {"$ref": "#/$defs/row"}}}}, "row": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "keyword", "status", "provider", "raw_response_sha256"], "properties": {"evidence_id": {"$ref": "#/$defs/id"}, "keyword": {"type": "string", "minLength": 1}, "status": {"const": "verified"}, "provider": {"enum": ["dataforseo", "agentseo"]}, "raw_response_sha256": {"$ref": "#/$defs/hash"}}}}
}
