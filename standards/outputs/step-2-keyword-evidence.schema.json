{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/outputs/step-2-keyword-evidence.schema.json",
  "title": "Heartweb Step 2 Keyword Evidence V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "run_id",
    "project_id",
    "step_id",
    "deployment_id",
    "revision",
    "source_artifact_ids",
    "evidence_ids",
    "decision_records",
    "candidate_status",
    "language",
    "geo",
    "pillars"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "step_id": {"const": "2"},
    "deployment_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "integer", "minimum": 1},
    "source_artifact_ids": {"$ref": "#/$defs/ids"},
    "evidence_ids": {"$ref": "#/$defs/ids"},
    "decision_records": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    },
    "candidate_status": {"const": "awaiting_gate"},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "geo": {"$ref": "#/$defs/geo"},
    "pillars": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/pillar"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{7,63}$"
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "geo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_code", "provider_location_code"],
      "properties": {
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "provider_location_code": {"type": "integer", "minimum": 1}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "outcome", "evidence_ids"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/id"},
        "outcome": {"type": "string", "minLength": 1},
        "evidence_ids": {"$ref": "#/$defs/ids"}
      }
    },
    "pillar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pillar_id", "status", "approved_category_families", "rows"],
      "properties": {
        "pillar_id": {"$ref": "#/$defs/id"},
        "status": {"const": "approved"},
        "approved_category_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "rows": {
          "type": "array",
          "minItems": 25,
          "maxItems": 40,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/row"}
        }
      }
    },
    "cpc_usd": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "value"],
          "properties": {
            "availability": {"const": "available"},
            "value": {"type": "number", "minimum": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "reason"],
          "properties": {
            "availability": {"const": "unavailable"},
            "reason": {"const": "not_returned_by_provider"}
          }
        }
      ]
    },
    "engine_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engines"],
      "properties": {
        "engines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "google_search",
              "google_ai_overviews",
              "local_maps",
              "bing",
              "perplexity",
              "claude",
              "chatgpt_search"
            ]
          }
        }
      }
    },
    "mandatory_location_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"enum": ["required", "not_required"]}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "title",
        "keyword",
        "search_volume",
        "difficulty",
        "cpc_usd",
        "category",
        "content_type",
        "geo_type",
        "engine_target",
        "information_gain",
        "entity_density",
        "business_relevance",
        "mandatory_location_policy",
        "status",
        "provider",
        "raw_response_sha256"
      ],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "keyword": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "search_volume": {"type": "integer", "minimum": 0},
        "difficulty": {"type": "number", "minimum": 0, "maximum": 100},
        "cpc_usd": {"$ref": "#/$defs/cpc_usd"},
        "category": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "content_type": {
          "enum": ["Pillar-Page", "Pillar", "Data-Hub", "Entity-Anchor", "FAQ-Hub", "Blogartikel", "Blog", "Ratgeber", "Comparison-Table", "Vergleichstabelle", "Landingpage", "Standort-Landingpage", "FAQ", "Ergaenzungsseite"]
        },
        "geo_type": {
          "enum": ["local_geo", "regional_geo", "national_geo", "international_geo"]
        },
        "engine_target": {"$ref": "#/$defs/engine_target"},
        "information_gain": {"type": "number", "minimum": 0},
        "entity_density": {"type": "number", "minimum": 0},
        "business_relevance": {"type": "number", "minimum": 0, "maximum": 1},
        "mandatory_location_policy": {"$ref": "#/$defs/mandatory_location_policy"},
        "status": {"const": "verified"},
        "provider": {"enum": ["dataforseo", "agentseo"]},
        "raw_response_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
