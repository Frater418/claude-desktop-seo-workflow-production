{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://heartweb.example/schema/outputs/step-3-plan.schema.json", "title": "Heartweb Step 3 Deterministic Plan V2", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "run_id", "project_id", "step_id", "deployment_id", "revision", "source_artifact_ids", "evidence_ids", "decision_records", "candidate_status", "solver_version", "solver_input", "solver_output", "solver_input_sha256", "solver_output_sha256", "weeks", "mandatory_item_ids", "backlog_item_ids", "vertical_links", "horizontal_links"],
  "properties": {"schema_version": {"const": "2.0.0"}, "artifact_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "project_id": {"$ref": "#/$defs/id"}, "step_id": {"const": "3"}, "deployment_id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1}, "source_artifact_ids": {"$ref": "#/$defs/ids"}, "evidence_ids": {"$ref": "#/$defs/ids"}, "decision_records": {"type": "array", "items": {"$ref": "#/$defs/decision"}}, "candidate_status": {"const": "awaiting_gate"}, "solver_version": {"type": "string", "minLength": 1}, "solver_input": {"type": "string", "minLength": 2}, "solver_output": {"type": "string", "minLength": 2}, "solver_input_sha256": {"$ref": "#/$defs/hash"}, "solver_output_sha256": {"$ref": "#/$defs/hash"}, "weeks": {"type": "array", "minItems": 17, "maxItems": 17, "items": {"$ref": "#/$defs/week"}}, "mandatory_item_ids": {"$ref": "#/$defs/ids"}, "backlog_item_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}, "vertical_links": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/vertical"}}, "horizontal_links": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/horizontal"}}},
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}, "ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "decision": {"type": "object", "additionalProperties": false, "required": ["decision_id", "outcome", "evidence_ids"], "properties": {"decision_id": {"$ref": "#/$defs/id"}, "outcome": {"type": "string", "minLength": 1}, "evidence_ids": {"$ref": "#/$defs/ids"}}}, "week": {"type": "object", "additionalProperties": false, "required": ["week", "capacity_hours", "item_ids"], "properties": {"week": {"type": "integer", "minimum": 1, "maximum": 17}, "capacity_hours": {"type": "number", "exclusiveMinimum": 0, "maximum": 15}, "item_ids": {"$ref": "#/$defs/ids"}}}, "vertical": {"type": "object", "additionalProperties": false, "required": ["source_item_id", "target_pillar_id"], "properties": {"source_item_id": {"$ref": "#/$defs/id"}, "target_pillar_id": {"$ref": "#/$defs/id"}}}, "horizontal": {"type": "object", "additionalProperties": false, "required": ["source_item_id", "target_item_id"], "properties": {"source_item_id": {"$ref": "#/$defs/id"}, "target_item_id": {"$ref": "#/$defs/id"}}}}
}
