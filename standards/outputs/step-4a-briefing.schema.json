{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/outputs/step-4a-briefing.schema.json",
  "title": "Heartweb Step 4A Briefing Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "run_id", "project_id", "deployment_id", "step_id", "revision", "source_artifact_ids", "evidence_ids", "decision_records", "candidate_status", "claim_ledger_artifact_id", "hero_direct_answer", "semantic_triples", "evidence_containers", "serp_evidence", "jsonld", "claim_bindings", "briefing_sections", "entity_bindings", "notion_frontmatter"],
  "properties": {
    "schema_version": {"const": "2.0.0"}, "artifact_id": {"$ref": "#/$defs/artifactId"}, "run_id": {"$ref": "#/$defs/runId"}, "project_id": {"$ref": "#/$defs/projectId"}, "deployment_id": {"$ref": "#/$defs/deploymentId"}, "step_id": {"const": "4a"}, "revision": {"type": "integer", "minimum": 1},
    "source_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactId"}}, "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceId"}}, "decision_records": {"type": "array", "items": {"$ref": "#/$defs/decision"}}, "candidate_status": {"const": "awaiting_gate"},
    "claim_ledger_artifact_id": {"$ref": "#/$defs/artifactId"}, "hero_direct_answer": {"$ref": "#/$defs/heroDirectAnswer"}, "semantic_triples": {"type": "array", "minItems": 15, "maxItems": 20, "items": {"$ref": "#/$defs/semanticTriple"}}, "evidence_containers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceContainer"}}, "serp_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/serpEvidence"}}, "jsonld": {"$ref": "#/$defs/jsonld"}, "claim_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claimBinding"}}, "briefing_sections": {"$ref": "#/$defs/briefingSections"}, "entity_bindings": {"$ref": "#/$defs/entityBindings"}, "notion_frontmatter": {"$ref": "#/$defs/notion"}
  },
  "$defs": {
    "artifactId": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "runId": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "projectId": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "deploymentId": {"type": "string", "pattern": "^deployment-[a-z0-9][a-z0-9-]{2,63}$"}, "evidenceId": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{7,63}$"},
    "decision": {"type": "object", "additionalProperties": false, "required": ["decision_id", "decision", "evidence_ids"], "properties": {"decision_id": {"type": "string", "pattern": "^decision-[a-z0-9][a-z0-9-]{7,63}$"}, "decision": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidenceId"}}}},
    "heroDirectAnswer": {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"type": "string", "minLength": 1, "pattern": "\\S"}}},
    "semanticTriple": {"type": "object", "additionalProperties": false, "required": ["triple_id", "subject", "predicate", "object", "evidence_ids"], "properties": {"triple_id": {"type": "string", "pattern": "^triple-[a-z0-9][a-z0-9-]{7,63}$"}, "subject": {"type": "string", "minLength": 1, "pattern": "\\S"}, "predicate": {"type": "string", "minLength": 1, "pattern": "\\S"}, "object": {"type": "string", "minLength": 1, "pattern": "\\S"}, "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceId"}}}},
    "evidenceContainer": {"type": "object", "additionalProperties": false, "required": ["section_id", "heading", "body", "evidence_ids"], "properties": {"section_id": {"type": "string", "minLength": 1, "pattern": "\\S"}, "heading": {"type": "string", "minLength": 1, "pattern": "\\S"}, "body": {"type": "string", "minLength": 1, "pattern": "\\S"}, "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceId"}}, "data_points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dataPoint"}}, "table": {"$ref": "#/$defs/evidenceTable"}}, "oneOf": [{"required": ["data_points"], "not": {"required": ["table"]}}, {"required": ["table"], "not": {"required": ["data_points"]}}]},
    "dataPoint": {"type": "object", "additionalProperties": false, "required": ["label", "value", "source_evidence_ids"], "properties": {"label": {"type": "string", "minLength": 1, "pattern": "\\S"}, "value": {"type": ["string", "number"]}, "unit": {"type": "string", "minLength": 1, "pattern": "\\S"}, "source_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceId"}}}},
    "evidenceTable": {"type": "object", "additionalProperties": false, "required": ["caption", "columns", "rows"], "properties": {"caption": {"type": "string", "minLength": 1, "pattern": "\\S"}, "columns": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "pattern": "\\S"}}, "rows": {"type": "array", "minItems": 1, "items": {"type": "array", "items": {"type": ["string", "number", "boolean", "null"]}}}}},
    "serpEvidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "gateway_request_id", "source"], "properties": {"evidence_id": {"$ref": "#/$defs/evidenceId"}, "gateway_request_id": {"type": "string", "pattern": "^request-[a-z0-9][a-z0-9-]{7,63}$"}, "source": {"const": "provider_gateway"}}},
    "jsonld": {"type": "object", "additionalProperties": false, "required": ["level", "graph", "graph_hash"], "properties": {"level": {"enum": ["basic", "enhanced"]}, "graph": {"type": "object", "required": ["@context", "@graph"]}, "graph_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}, "claimBinding": {"type": "object", "additionalProperties": false, "required": ["claim_id", "graph_node_id"], "properties": {"claim_id": {"$ref": "#/$defs/claimId"}, "graph_node_id": {"type": "string", "format": "uri"}, "property_path": {"type": "string", "pattern": "^/"}}}, "claimId": {"type": "string", "pattern": "^claim-[a-z0-9][a-z0-9-]{7,63}$"},
    "nonWhitespaceString": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "nonEmptyUniqueStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/nonWhitespaceString"}},
    "definitiveLanguageGuidance": {"type": "object", "additionalProperties": false, "required": ["required", "preferred_patterns", "prohibited_patterns", "rationale"], "properties": {"required": {"const": true}, "preferred_patterns": {"$ref": "#/$defs/nonEmptyUniqueStrings"}, "prohibited_patterns": {"$ref": "#/$defs/nonEmptyUniqueStrings"}, "rationale": {"$ref": "#/$defs/nonWhitespaceString"}}},
    "briefingSections": {"type": "object", "additionalProperties": false, "required": ["audience", "search_intent", "primary_keyword", "content_goal", "tone", "cta_guidance", "internal_link_guidance", "copywriter_instructions", "secondary_keywords", "outline", "publication_checklist", "definitive_language_guidance"], "properties": {"audience": {"$ref": "#/$defs/nonWhitespaceString"}, "search_intent": {"$ref": "#/$defs/nonWhitespaceString"}, "primary_keyword": {"$ref": "#/$defs/nonWhitespaceString"}, "content_goal": {"$ref": "#/$defs/nonWhitespaceString"}, "tone": {"$ref": "#/$defs/nonWhitespaceString"}, "cta_guidance": {"$ref": "#/$defs/nonWhitespaceString"}, "internal_link_guidance": {"$ref": "#/$defs/nonWhitespaceString"}, "copywriter_instructions": {"$ref": "#/$defs/nonWhitespaceString"}, "secondary_keywords": {"$ref": "#/$defs/nonEmptyUniqueStrings"}, "outline": {"$ref": "#/$defs/nonEmptyUniqueStrings"}, "publication_checklist": {"$ref": "#/$defs/nonEmptyUniqueStrings"}, "definitive_language_guidance": {"$ref": "#/$defs/definitiveLanguageGuidance"}}},
    "entityBinding": {"type": "object", "additionalProperties": false, "required": ["name", "wikidata_uri", "graph_node_id"], "properties": {"name": {"$ref": "#/$defs/nonWhitespaceString"}, "wikidata_uri": {"type": "string", "pattern": "^https://www\\.wikidata\\.org/wiki/Q[1-9][0-9]*$"}, "graph_node_id": {"type": "string", "format": "uri"}}},
    "entityBindings": {"type": "object", "additionalProperties": false, "required": ["about", "mentions"], "properties": {"about": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/entityBinding"}}, "mentions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/entityBinding"}}}},
    "notion": {"type": "object", "additionalProperties": false, "required": ["derived", "projection_schema_version"], "properties": {"derived": {"const": true}, "projection_schema_version": {"const": "2.0.0"}}}
  }
}
