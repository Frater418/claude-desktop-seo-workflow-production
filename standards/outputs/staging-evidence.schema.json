{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://heartweb.example/schema/outputs/staging-evidence.schema.json", "title": "Heartweb Staging Evidence", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "run_id", "project_id", "deployment_id", "step_id", "revision", "source_artifact_ids", "evidence_ids", "decision_records", "candidate_status", "content_sha256", "staging_sha256", "checks"],
  "properties": {"schema_version": {"const": "2.0.0"}, "artifact_id": {"$ref": "#/$defs/artifactId"}, "run_id": {"$ref": "#/$defs/runId"}, "project_id": {"$ref": "#/$defs/projectId"}, "deployment_id": {"$ref": "#/$defs/deploymentId"}, "step_id": {"const": "4b"}, "revision": {"type": "integer", "minimum": 1}, "source_artifact_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactId"}}, "evidence_ids": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceId"}}, "decision_records": {"type": "array", "items": {"type": "object"}}, "candidate_status": {"const": "awaiting_gate"}, "content_sha256": {"$ref": "#/$defs/hash"}, "staging_sha256": {"$ref": "#/$defs/hash"}, "checks": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/check"}}},
  "$defs": {"artifactId": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "runId": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "projectId": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "deploymentId": {"type": "string", "pattern": "^(?:deployment|dep)-[a-z0-9][a-z0-9-]{2,63}$"}, "evidenceId": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{7,63}$"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "check": {"type": "object", "additionalProperties": false, "required": ["tool", "evidence_id", "report_sha256", "content_sha256", "provenance"], "properties": {"tool": {"enum": ["crawl", "lighthouse", "axe", "visual"]}, "evidence_id": {"$ref": "#/$defs/evidenceId"}, "report_sha256": {"$ref": "#/$defs/hash"}, "content_sha256": {"$ref": "#/$defs/hash"}, "provenance": {"$ref": "#/$defs/provenance"}}}, "provenance": {"type": "object", "additionalProperties": false, "required": ["classification", "source"], "properties": {"classification": {"enum": ["local_simulated", "external_report"]}, "source": {"type": "string", "pattern": "\\S"}}}}
}
