{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/outputs/step-1b-architecture.schema.json",
  "title": "Heartweb Step 1B Canonical Architecture V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "run_id", "project_id", "deployment_id", "step_id", "revision", "source_artifact_ids", "evidence_ids", "decision_records", "candidate_status", "page_type_legend", "open_confirmations", "content_decisions", "link_graph"],
  "properties": {
    "schema_version": {"const": "2.0.0"}, "artifact_id": {"$ref": "#/$defs/artifactId"}, "run_id": {"$ref": "#/$defs/runId"}, "project_id": {"$ref": "#/$defs/projectId"}, "deployment_id": {"$ref": "#/$defs/deploymentId"}, "step_id": {"const": "1b"}, "revision": {"type": "integer", "minimum": 1}, "source_artifact_ids": {"$ref": "#/$defs/artifactIds"}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}, "decision_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decisionRecord"}}, "candidate_status": {"const": "awaiting_gate"}, "page_type_legend": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pageTypeLegendEntry"}}, "open_confirmations": {"type": "array", "items": {"$ref": "#/$defs/openConfirmation"}}, "content_decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contentDecision"}}, "link_graph": {"type": "array", "items": {"$ref": "#/$defs/link"}}
  },
  "$defs": {
    "artifactId": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "runId": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "projectId": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "deploymentId": {"type": "string", "pattern": "^dep-[a-z0-9][a-z0-9-]{2,63}$"}, "evidenceId": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{7,63}$"}, "contentId": {"type": "string", "pattern": "^(pillar|cluster)-[a-z0-9][a-z0-9-]{2,63}$"},
    "artifactIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactId"}}, "evidenceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceId"}},
    "decisionRecord": {"type": "object", "additionalProperties": false, "required": ["decision_id", "question", "outcome", "evidence_ids"], "properties": {"decision_id": {"type": "string", "pattern": "^decision-[a-z0-9][a-z0-9-]{2,63}$"}, "question": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "minLength": 1}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}},
    "pageTypeLegendEntry": {"type": "object", "additionalProperties": false, "required": ["code", "label", "description"], "properties": {"code": {"enum": ["pillar_page", "cluster_page"]}, "label": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
    "openConfirmation": {"type": "object", "additionalProperties": false, "required": ["confirmation_id", "question", "status", "content_ids"], "properties": {"confirmation_id": {"type": "string", "pattern": "^confirmation-[a-z0-9][a-z0-9-]{2,63}$"}, "question": {"type": "string", "minLength": 1}, "status": {"const": "open"}, "content_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/contentId"}}}},
    "contentDecision": {"type": "object", "additionalProperties": false, "required": ["content_id", "decision", "url", "canonical_url", "navigation", "page_type", "display_label", "presentation_status"], "properties": {"content_id": {"$ref": "#/$defs/contentId"}, "decision": {"enum": ["existing", "new", "update", "merge", "redirect", "backlog"]}, "url": {"type": "string", "pattern": "^/[a-z0-9/-]*$"}, "canonical_url": {"type": "string", "format": "uri"}, "navigation": {"enum": ["primary", "child", "footer", "none"]}, "redirect_to_url": {"type": "string", "format": "uri"}, "page_type": {"enum": ["pillar_page", "cluster_page"]}, "display_label": {"type": "string", "minLength": 1}, "parent_content_id": {"$ref": "#/$defs/contentId"}, "presentation_status": {"enum": ["confirmed", "open"]}}, "allOf": [{"if": {"properties": {"decision": {"const": "redirect"}}, "required": ["decision"]}, "then": {"required": ["redirect_to_url"]}}, {"if": {"properties": {"page_type": {"const": "cluster_page"}}, "required": ["page_type"]}, "then": {"required": ["parent_content_id"]}}, {"if": {"properties": {"page_type": {"const": "pillar_page"}}, "required": ["page_type"]}, "then": {"not": {"required": ["parent_content_id"]}}}]},
    "link": {"type": "object", "additionalProperties": false, "required": ["from_content_id", "to_content_id", "relationship"], "properties": {"from_content_id": {"$ref": "#/$defs/contentId"}, "to_content_id": {"$ref": "#/$defs/contentId"}, "relationship": {"enum": ["vertical", "horizontal"]}}}
  }
}
