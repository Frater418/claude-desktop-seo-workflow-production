    "comparisonSection": {"allOf": [{"$ref": "#/$defs/sectionBase"}], "unevaluatedProperties": false, "required": ["role", "content", "microdata"], "properties": {"role": {"const": "comparison"}, "microdata": {"$ref": "#/$defs/comparisonMicrodata"}, "content": {"type": "object", "additionalProperties": false, "required": ["table"], "properties": {"table": {"$ref": "#/$defs/comparisonTable"}}}}},
