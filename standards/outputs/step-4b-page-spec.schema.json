    "heroSection": {"allOf": [{"$ref": "#/$defs/sectionBase"}], "unevaluatedProperties": false, "required": ["role", "content"], "properties": {"role": {"const": "hero"}, "content": {"type": "object", "additionalProperties": false, "required": ["summary", "primary_cta_id"], "properties": {"summary": {"$ref": "#/$defs/text"}, "primary_cta_id": {"$ref": "#/$defs/semanticId"}}}}},
