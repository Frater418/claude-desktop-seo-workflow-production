    "componentClasses": {"type": "array", "uniqueItems": true, "items": {"enum": ["definition-block", "evidence-container", "comparison-table-wrapper", "comparison-table", "speakable-section", "badge-datahub"]}}, "microdataItemtype": {"type": "string", "pattern": "^https://schema\\.org/[A-Za-z][A-Za-z0-9]*$"}, "definitionMicrodata": {"type": "object", "additionalProperties": false, "required": ["itemtype", "heading_itemprop", "body_itemprop"], "properties": {"itemtype": {"$ref": "#/$defs/microdataItemtype"}, "heading_itemprop": {"const": "name"}, "body_itemprop": {"const": "description"}}}, "evidenceMicrodata": {"type": "object", "additionalProperties": false, "required": ["itemtype", "heading_itemprop", "body_itemprop", "content_itemprop"], "properties": {"itemtype": {"$ref": "#/$defs/microdataItemtype"}, "heading_itemprop": {"const": "name"}, "body_itemprop": {"const": "description"}, "content_itemprop": {"enum": ["additionalProperty", "citation"]}}}, "comparisonMicrodata": {"type": "object", "additionalProperties": false, "required": ["itemtype", "heading_itemprop", "table_itemprop"], "properties": {"itemtype": {"$ref": "#/$defs/microdataItemtype"}, "heading_itemprop": {"const": "name"}, "table_itemprop": {"const": "itemListElement"}}},
