{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/outputs/step-4b-page-spec.schema.json",
  "title": "Heartweb Step 4B Page Specification Candidate",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "run_id", "project_id", "deployment_id", "step_id", "revision", "source_artifact_ids", "evidence_ids", "decision_records", "candidate_status", "language", "locale", "html", "meta", "canonical_url", "jsonld", "content_sha256", "forms", "consent", "tracking_slots", "service_area", "accessibility", "responsive", "sibling_links"],
  "properties": {
    "schema_version": {"const": "2.0.0"}, "artifact_id": {"$ref": "#/$defs/artifactId"}, "run_id": {"$ref": "#/$defs/runId"}, "project_id": {"$ref": "#/$defs/projectId"}, "deployment_id": {"$ref": "#/$defs/deploymentId"}, "step_id": {"const": "4b"}, "revision": {"type": "integer", "minimum": 1}, "source_artifact_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactId"}}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceId"}}, "decision_records": {"type": "array", "items": {"$ref": "#/$defs/decision"}}, "candidate_status": {"const": "awaiting_gate"},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}$"}, "locale": {"type": "string", "pattern": "^[a-z]{2,3}-[A-Z]{2}$"}, "html": {"type": "string", "minLength": 1}, "meta": {"type": "object", "additionalProperties": false, "required": ["title", "description"], "properties": {"title": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}}, "canonical_url": {"type": "string", "format": "uri"}, "jsonld": {"$ref": "#/$defs/jsonld"}, "content_sha256": {"$ref": "#/$defs/hash"}, "forms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/form"}}, "consent": {"$ref": "#/$defs/consent"}, "tracking_slots": {"type": "array", "items": {"$ref": "#/$defs/tracking"}}, "service_area": {"$ref": "#/$defs/serviceArea"}, "accessibility": {"$ref": "#/$defs/accessibility"}, "responsive": {"$ref": "#/$defs/responsive"}, "sibling_links": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}}
  },
  "$defs": {
    "artifactId": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "runId": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "projectId": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "deploymentId": {"type": "string", "pattern": "^(?:deployment|dep)-[a-z0-9][a-z0-9-]{2,63}$"}, "evidenceId": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{7,63}$"}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"type": "object", "additionalProperties": false, "required": ["decision_id", "decision"], "properties": {"decision_id": {"type": "string", "pattern": "^decision-[a-z0-9][a-z0-9-]{7,63}$"}, "decision": {"type": "string", "minLength": 1}}}, "jsonld": {"type": "object", "additionalProperties": false, "required": ["level", "graph", "graph_hash"], "properties": {"level": {"enum": ["basic", "enhanced"]}, "graph": {"type": "object", "required": ["@context", "@graph"]}, "graph_hash": {"$ref": "#/$defs/hash"}}}, "form": {"type": "object", "additionalProperties": false, "required": ["form_id", "consent_required"], "properties": {"form_id": {"type": "string", "minLength": 1}, "consent_required": {"const": true}}}, "consent": {"type": "object", "additionalProperties": false, "required": ["policy_id", "required"], "properties": {"policy_id": {"type": "string", "minLength": 1}, "required": {"const": true}}}, "tracking": {"type": "object", "additionalProperties": false, "required": ["slot_id", "consent_category"], "properties": {"slot_id": {"type": "string", "minLength": 1}, "consent_category": {"type": "string", "minLength": 1}}}, "serviceArea": {"type": "object", "additionalProperties": false, "required": ["mode", "areas", "address_claims"], "properties": {"mode": {"enum": ["service_area", "physical_location"]}, "areas": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "address_claims": {"type": "array", "items": {"type": "string"}}}}, "accessibility": {"type": "object", "additionalProperties": false, "required": ["axe_evidence_id"], "properties": {"axe_evidence_id": {"$ref": "#/$defs/evidenceId"}}}, "responsive": {"type": "object", "additionalProperties": false, "required": ["visual_evidence_id"], "properties": {"visual_evidence_id": {"$ref": "#/$defs/evidenceId"}}}
  }
}
