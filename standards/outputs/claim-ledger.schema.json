{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/outputs/claim-ledger.schema.json",
  "title": "Heartweb Claim Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "run_id", "project_id", "step_id", "revision", "source_artifact_ids", "evidence_ids", "decision_records", "candidate_status", "claims"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_id": {"$ref": "#/$defs/artifactId"},
    "run_id": {"$ref": "#/$defs/runId"},
    "project_id": {"$ref": "#/$defs/projectId"},
    "step_id": {"const": "4a"},
    "revision": {"type": "integer", "minimum": 1},
    "source_artifact_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactId"}},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceId"}},
    "decision_records": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "candidate_status": {"const": "awaiting_gate"},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}}
  },
  "$defs": {
    "artifactId": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"},
    "runId": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"},
    "projectId": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"},
    "evidenceId": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{7,63}$"},
    "decision": {"type": "object", "additionalProperties": false, "required": ["decision_id", "decision", "evidence_ids"], "properties": {"decision_id": {"type": "string", "pattern": "^decision-[a-z0-9][a-z0-9-]{7,63}$"}, "decision": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "items": {"$ref": "#/$defs/evidenceId"}}}},
    "claim": {"type": "object", "additionalProperties": false, "required": ["claim_id", "claim_type", "text", "evidence_ids", "reviewer_policy", "review_status"], "properties": {"claim_id": {"type": "string", "pattern": "^claim-[a-z0-9][a-z0-9-]{7,63}$"}, "claim_type": {"enum": ["factual", "medical", "financial", "legal", "local_presence", "testimonial"]}, "text": {"type": "string", "minLength": 1}, "evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceId"}}, "reviewer_policy": {"type": "string", "minLength": 1}, "review_status": {"const": "pending"}}}
  }
}
