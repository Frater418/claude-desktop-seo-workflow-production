{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/outputs/step-1c-design-system.schema.json",
  "title": "Heartweb Step 1C Canonical Design System V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "run_id", "project_id", "deployment_id", "step_id", "revision", "source_artifact_ids", "evidence_ids", "decision_records", "candidate_status", "tokens", "accessibility", "brand_consistency"],
  "properties": {"schema_version": {"const": "2.0.0"}, "artifact_id": {"$ref": "#/$defs/artifactId"}, "run_id": {"$ref": "#/$defs/runId"}, "project_id": {"$ref": "#/$defs/projectId"}, "deployment_id": {"$ref": "#/$defs/deploymentId"}, "step_id": {"const": "1c"}, "revision": {"type": "integer", "minimum": 1}, "source_artifact_ids": {"$ref": "#/$defs/artifactIds"}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}, "decision_records": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decisionRecord"}}, "candidate_status": {"const": "awaiting_gate"}, "tokens": {"$ref": "#/$defs/tokens"}, "accessibility": {"$ref": "#/$defs/accessibility"}, "brand_consistency": {"$ref": "#/$defs/brandConsistency"}},
  "$defs": {
    "artifactId": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "runId": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "projectId": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "deploymentId": {"type": "string", "pattern": "^dep-[a-z0-9][a-z0-9-]{2,63}$"}, "evidenceId": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{7,63}$"}, "artifactIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifactId"}}, "evidenceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceId"}},
    "decisionRecord": {"type": "object", "additionalProperties": false, "required": ["decision_id", "question", "outcome", "evidence_ids"], "properties": {"decision_id": {"type": "string", "pattern": "^decision-[a-z0-9][a-z0-9-]{2,63}$"}, "question": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "minLength": 1}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}},
    "tokens": {"type": "object", "additionalProperties": false, "required": ["color_primary", "color_surface", "font_body", "radius_card"], "properties": {"color_primary": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}, "color_surface": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}, "font_body": {"type": "string", "pattern": "^[A-Za-z0-9 ,_-]+$"}, "radius_card": {"type": "string", "pattern": "^[0-9]+(px|rem)$"}}},
    "accessibility": {"type": "object", "additionalProperties": false, "required": ["contrast_evidence_ids", "focus_indicator"], "properties": {"contrast_evidence_ids": {"$ref": "#/$defs/evidenceIds"}, "focus_indicator": {"const": "visible"}}},
    "brandConsistency": {"type": "object", "additionalProperties": false, "required": ["approved_brand_name", "approved_direction", "evidence_ids"], "properties": {"approved_brand_name": {"type": "string", "minLength": 1, "maxLength": 120}, "approved_direction": {"type": "string", "minLength": 1, "maxLength": 300}, "evidence_ids": {"$ref": "#/$defs/evidenceIds"}}}
  }
}
