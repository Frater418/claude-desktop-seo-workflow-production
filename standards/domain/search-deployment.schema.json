{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/search-deployment.schema.json",
  "title": "Heartweb Search Deployment",
  "type": "object",
  "additionalProperties": false,
  "required": ["deployment_id", "brand_id", "domain_ids", "physical_location_ids", "service_area_ids", "market_id", "country_code", "target_regions", "legal_jurisdiction", "language", "locale", "market_phase", "deployment_role", "seo_operating_model", "provider_location_verification", "search_engines"],
  "properties": {
    "deployment_id": {"type": "string", "pattern": "^dep-[a-z0-9][a-z0-9-]{2,63}$"},
    "brand_id": {"type": "string", "pattern": "^brand-[a-z0-9][a-z0-9-]{2,63}$"},
    "domain_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^domain-[a-z0-9][a-z0-9-]{2,63}$"}},
    "physical_location_ids": {"type": "array", "items": {"type": "string", "pattern": "^location-[a-z0-9][a-z0-9-]{2,63}$"}},
    "service_area_ids": {"type": "array", "items": {"type": "string", "pattern": "^service-area-[a-z0-9][a-z0-9-]{2,63}$"}},
    "market_id": {"type": "string", "pattern": "^[a-z]{2}-[a-z]{2}-[a-z0-9-]+$"},
    "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "target_regions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "legal_jurisdiction": {"type": "string", "minLength": 2},
    "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
    "locale": {"type": "string", "pattern": "^[a-z]{2,3}-[A-Z]{2}$"},
    "market_phase": {"type": "string", "enum": ["active", "planned", "discovery", "paused"]},
    "deployment_role": {"type": "string", "enum": ["primary", "satellite", "expansion", "campaign"]},
    "seo_operating_model": {"type": "string", "enum": ["local", "regional", "national", "international", "programmatic_local", "digital"]},
    "provider_location_verification": {"$ref": "market-registry.schema.json#/$defs/providerLocationVerification"},
    "search_engines": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["google_classic", "google_ai_overviews", "local_maps", "bing", "perplexity", "chatgpt_search"]}}
  }
}
