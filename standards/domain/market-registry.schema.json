{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/market-registry.schema.json",
  "title": "Heartweb Market Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_version", "markets"],
  "properties": {
    "registry_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "markets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/market"}}
  },
  "$defs": {
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["market_id", "country_code", "language", "locale", "legal_jurisdiction", "provider_location_verification"],
      "properties": {
        "market_id": {"type": "string", "pattern": "^[a-z]{2}-[a-z]{2}-[a-z0-9-]+$"},
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "language": {"type": "string", "pattern": "^[a-z]{2,3}$"},
        "locale": {"type": "string", "pattern": "^[a-z]{2,3}-[A-Z]{2}$"},
        "legal_jurisdiction": {"type": "string", "minLength": 2},
        "provider_location_verification": {"$ref": "#/$defs/providerLocationVerification"}
      }
    },
    "providerLocationVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "provider_location_code"],
      "properties": {
        "status": {"type": "string", "enum": ["verified", "unknown", "not_applicable"]},
        "provider_location_code": {"type": ["integer", "null"], "minimum": 1},
        "verified_at": {"type": ["string", "null"], "format": "date-time"},
        "verification_source": {"type": ["string", "null"], "enum": ["provider_response", "provider_documentation", null]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "verified"}}}, "then": {"properties": {"provider_location_code": {"type": "integer"}, "verified_at": {"type": "string"}, "verification_source": {"type": "string"}}}},
        {"if": {"properties": {"status": {"enum": ["unknown", "not_applicable"]}}}, "then": {"properties": {"provider_location_code": {"const": null}, "verified_at": {"const": null}, "verification_source": {"const": null}}}}
      ]
    }
  }
}
