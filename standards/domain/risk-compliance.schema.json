{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/risk-compliance.schema.json",
  "title": "Heartweb Risk and Compliance",
  "type": "object",
  "additionalProperties": false,
  "required": ["ymyl", "regulated_categories", "claim_evidence", "reviewer_policy"],
  "properties": {
    "ymyl": {"type": "boolean"},
    "regulated_categories": {"type": "array", "items": {"type": "string", "enum": ["medical", "care", "finance", "education", "wellness", "none"]}},
    "claim_evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "reviewer_policy": {"type": "string", "enum": ["required", "not_required"]}
  },
  "allOf": [{"if": {"properties": {"ymyl": {"const": true}}}, "then": {"properties": {"claim_evidence": {"minItems": 1}, "reviewer_policy": {"const": "required"}}}}],
  "$defs": {"evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "source", "retrieved_on", "jurisdiction"], "properties": {"evidence_id": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{2,63}$"}, "source": {"type": "string", "format": "uri"}, "retrieved_on": {"type": "string", "format": "date"}, "jurisdiction": {"type": "string", "minLength": 2}}}}
}
