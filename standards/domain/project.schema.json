{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/project.schema.json",
  "title": "Heartweb Foundation Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "author", "created_at", "source_legacy_manifest", "tenant", "customer", "target_audiences", "business_goal", "brand_tone", "core_services", "entity_domain_gbp", "market_deployments", "workstreams", "conversion_model", "risk_compliance"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"},
    "author": {"type": "string", "enum": ["Raphael Rechberger"]},
    "created_at": {"type": "string", "format": "date-time"},
    "source_legacy_manifest": {"$ref": "#/$defs/sourceLegacyManifest"},
    "tenant": {"$ref": "#/$defs/tenant"},
    "customer": {"$ref": "#/$defs/customer"},
    "target_audiences": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "business_goal": {"type": "string", "minLength": 1},
    "brand_tone": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "core_services": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "entity_domain_gbp": {"$ref": "entity-domain-gbp.schema.json"},
    "market_deployments": {"type": "array", "minItems": 1, "items": {"$ref": "search-deployment.schema.json"}},
    "workstreams": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/workstream"}},
    "conversion_model": {"$ref": "#/$defs/conversionModel"},
    "risk_compliance": {"$ref": "risk-compliance.schema.json"}
  },
  "$defs": {
    "sourceLegacyManifest": {"type": "object", "additionalProperties": false, "required": ["source", "sha256"], "properties": {"source": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "tenant": {"type": "object", "additionalProperties": false, "required": ["tenant_id", "name"], "properties": {"tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "name": {"type": "string", "minLength": 1}}},
    "customer": {"type": "object", "additionalProperties": false, "required": ["customer_id", "name"], "properties": {"customer_id": {"type": "string", "pattern": "^customer-[a-z0-9][a-z0-9-]{2,63}$"}, "name": {"type": "string", "minLength": 1}}},
    "workstream": {"type": "object", "additionalProperties": false, "required": ["workstream_id", "type"], "properties": {"workstream_id": {"type": "string", "pattern": "^workstream-[a-z0-9][a-z0-9-]{2,63}$"}, "type": {"type": "string", "enum": ["seo", "geo", "gbp", "ota", "social", "content", "recruiting"]}}},
    "conversionModel": {"type": "object", "additionalProperties": false, "required": ["primary"], "properties": {"primary": {"type": "string", "enum": ["lead", "phone_call", "booking", "consultation", "upload_quote", "application", "ota", "gbp_action"]}}}
  }
}
