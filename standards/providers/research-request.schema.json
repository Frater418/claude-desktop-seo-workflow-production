{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/providers/research-request.schema.json",
  "title": "Heartweb Provider Neutral Research Request V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "run_id", "project_id", "deployment_id", "revision", "source_artifact_ids", "evidence_ids", "decision_records", "candidate_status", "provider", "operation", "idempotency_key", "request_sha256", "geo", "language", "device", "cost", "gateway_route"],
  "properties": {
    "schema_version": {"enum": ["2.0.0", "2.1.0"]}, "request_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "project_id": {"$ref": "#/$defs/id"}, "deployment_id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1},
    "source_artifact_ids": {"$ref": "#/$defs/ids"}, "evidence_ids": {"$ref": "#/$defs/ids"}, "decision_records": {"type": "array", "items": {"$ref": "#/$defs/decision"}}, "candidate_status": {"const": "candidate"},
    "provider": {"enum": ["dataforseo", "agentseo"]}, "operation": {"enum": ["keyword_metrics", "serp_analysis"]}, "idempotency_key": {"type": "string", "minLength": 8}, "request_sha256": {"$ref": "#/$defs/hash"},
    "geo": {"$ref": "#/$defs/geo"}, "language": {"type": "string", "pattern": "^[a-z]{2,3}$"}, "device": {"enum": ["desktop", "mobile"]}, "parameters": {"type": "object", "minProperties": 1}, "cost": {"oneOf": [{"$ref": "#/$defs/requestCostUsd"}, {"$ref": "#/$defs/requestCostCredits"}]}, "gateway_route": {"const": "provider_gateway"}
  },
  "allOf": [
    {"if": {"properties": {"schema_version": {"const": "2.0.0"}}}, "then": {"properties": {"cost": {"$ref": "#/$defs/requestCostUsd"}}}},
    {"if": {"properties": {"schema_version": {"const": "2.1.0"}}}, "then": {"required": ["parameters"], "properties": {"cost": {"$ref": "#/$defs/requestCostCredits"}}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{7,63}$"}, "ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "geo": {"type": "object", "additionalProperties": false, "required": ["country_code", "provider_location_code"], "properties": {"country_code": {"type": "string", "pattern": "^[A-Z]{2}$"}, "provider_location_code": {"type": "integer", "minimum": 1}}},
    "requestCostUsd": {"type": "object", "additionalProperties": false, "required": ["currency", "maximum"], "properties": {"currency": {"const": "USD"}, "maximum": {"type": "number", "exclusiveMinimum": 0}}},
    "requestCostCredits": {"type": "object", "additionalProperties": false, "required": ["billing_unit", "provider_reported", "maximum_calls", "maximum_items"], "properties": {"billing_unit": {"const": "credits"}, "provider_reported": {"const": false}, "maximum_calls": {"type": "integer", "minimum": 1}, "maximum_items": {"type": "integer", "minimum": 1}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["decision_id", "outcome", "evidence_ids"], "properties": {"decision_id": {"$ref": "#/$defs/id"}, "outcome": {"type": "string", "minLength": 1}, "evidence_ids": {"$ref": "#/$defs/ids"}}}
  }
}
