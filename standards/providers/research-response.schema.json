{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/providers/research-response.schema.json",
  "title": "Heartweb Provider Neutral Research Response V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "response_id", "request_id", "run_id", "project_id", "deployment_id", "revision", "source_artifact_ids", "evidence_ids", "decision_records", "candidate_status", "provider", "provider_job_id", "status", "geo", "language", "device", "cost", "raw_response", "raw_response_sha256"],
  "properties": {
    "schema_version": {"const": "2.0.0"}, "response_id": {"$ref": "#/$defs/id"}, "request_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"}, "project_id": {"$ref": "#/$defs/id"}, "deployment_id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1}, "source_artifact_ids": {"$ref": "#/$defs/ids"}, "evidence_ids": {"$ref": "#/$defs/ids"}, "decision_records": {"type": "array", "items": {"$ref": "#/$defs/decision"}}, "candidate_status": {"const": "candidate"},
    "provider": {"enum": ["dataforseo", "agentseo"]}, "provider_job_id": {"type": "string", "minLength": 1}, "status": {"const": "completed"}, "geo": {"$ref": "#/$defs/geo"}, "language": {"type": "string", "pattern": "^[a-z]{2,3}$"}, "device": {"enum": ["desktop", "mobile"]}, "cost": {"$ref": "#/$defs/cost"}, "raw_response": {"type": "object", "minProperties": 1}, "raw_response_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{7,63}$"}, "ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "geo": {"type": "object", "additionalProperties": false, "required": ["country_code", "provider_location_code"], "properties": {"country_code": {"type": "string", "pattern": "^[A-Z]{2}$"}, "provider_location_code": {"type": "integer", "minimum": 1}}}, "cost": {"type": "object", "additionalProperties": false, "required": ["currency", "actual"], "properties": {"currency": {"const": "USD"}, "actual": {"type": "number", "minimum": 0}}}, "decision": {"type": "object", "additionalProperties": false, "required": ["decision_id", "outcome", "evidence_ids"], "properties": {"decision_id": {"$ref": "#/$defs/id"}, "outcome": {"type": "string", "minLength": 1}, "evidence_ids": {"$ref": "#/$defs/ids"}}}}
}
