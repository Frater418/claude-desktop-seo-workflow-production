{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/operator/revision-request.schema.json",
  "title": "Heartweb Revision Request", "type": "object", "additionalProperties": false,
  "required": ["revision_request_id", "tenant_id", "project_id", "run_id", "step_id", "current_artifact_id", "current_content_sha256", "current_revision", "artifact", "affected_sections", "problem", "expected_result", "immutable_constraints", "evidence", "reviewer_feedback", "attempt_number", "status", "requested_by", "requested_at"],
  "properties": {
    "revision_request_id": {"type": "string", "pattern": "^revision-[a-z0-9][a-z0-9-]{7,63}$"}, "tenant_id": {"$ref": "#/$defs/tenant_id"}, "project_id": {"$ref": "#/$defs/project_id"}, "run_id": {"$ref": "#/$defs/run_id"}, "step_id": {"$ref": "#/$defs/step_id"}, "current_artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "current_content_sha256": {"$ref": "#/$defs/sha256"}, "current_revision": {"type": "integer", "minimum": 1}, "artifact": {"$ref": "#/$defs/artifact"}, "affected_sections": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "problem": {"type": "string", "minLength": 1}, "expected_result": {"type": "string", "minLength": 1}, "immutable_constraints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "evidence": {"$ref": "#/$defs/evidence"}, "reviewer_feedback": {"type": "string", "minLength": 1}, "attempt_number": {"type": "integer", "minimum": 1, "maximum": 3}, "status": {"enum": ["open", "addressed", "superseded"]}, "requested_by": {"type": "string", "pattern": "^reviewer-[a-z0-9][a-z0-9-]{2,63}$"}, "requested_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "step_id": {"type": "string", "enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "content_sha256", "revision"], "properties": {"artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "revision": {"type": "integer", "minimum": 1}}}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "content_sha256"], "properties": {"evidence_id": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{7,63}$"}, "content_sha256": {"$ref": "#/$defs/sha256"}}}}}
}
