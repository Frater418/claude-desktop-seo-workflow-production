{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/operator/workflow-defect.schema.json",
  "title": "Heartweb Workflow Defect", "type": "object", "additionalProperties": false,
  "required": ["defect_id", "tenant_id", "project_id", "affected_run_id", "step_id", "title", "expected_behavior", "actual_behavior", "reproducer", "severity", "regression_test_status", "owner_role", "status", "evidence", "reported_at"],
  "properties": {"defect_id": {"type": "string", "pattern": "^defect-[a-z0-9][a-z0-9-]{7,63}$"}, "tenant_id": {"$ref": "#/$defs/tenant_id"}, "project_id": {"$ref": "#/$defs/project_id"}, "affected_run_id": {"$ref": "#/$defs/run_id"}, "step_id": {"$ref": "#/$defs/step_id"}, "title": {"type": "string", "minLength": 1}, "expected_behavior": {"type": "string", "minLength": 1}, "actual_behavior": {"type": "string", "minLength": 1}, "reproducer": {"type": "string", "minLength": 1}, "severity": {"enum": ["critical", "high", "medium", "low"]}, "regression_test_status": {"enum": ["required", "added", "not_applicable"]}, "owner_role": {"const": "workflow_maintainer"}, "status": {"enum": ["open", "investigating", "fixed", "verified", "closed"]}, "evidence": {"$ref": "#/$defs/evidence"}, "reported_at": {"type": "string", "format": "date-time"}},
  "$defs": {"tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "step_id": {"type": "string", "enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "content_sha256"], "properties": {"evidence_id": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{7,63}$"}, "content_sha256": {"$ref": "#/$defs/sha256"}}}}}
}
