{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/operator/operator-task.schema.json",
  "title": "Heartweb Operator Task", "type": "object", "additionalProperties": false,
  "required": ["task_id", "tenant_id", "project_id", "run_id", "step_id", "task_type", "title", "description", "owner_role", "priority", "blocking_scope", "artifact", "evidence", "acceptance_criteria", "resolution_method", "status", "operator_action"],
  "properties": {
    "task_id": {"$ref": "#/$defs/task_id"}, "tenant_id": {"$ref": "#/$defs/tenant_id"}, "project_id": {"$ref": "#/$defs/project_id"}, "run_id": {"$ref": "#/$defs/run_id"}, "step_id": {"$ref": "#/$defs/step_id"},
    "task_type": {"enum": ["missing_input", "revision_required", "waiver_candidate", "retryable_technical"]}, "title": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "owner_role": {"$ref": "#/$defs/owner_role"}, "priority": {"enum": ["critical", "high", "normal", "low"]}, "blocking_scope": {"$ref": "#/$defs/blocking_scope"}, "due_at": {"type": "string", "format": "date-time"},
    "artifact": {"$ref": "#/$defs/artifact"}, "evidence": {"$ref": "#/$defs/evidence"}, "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "resolution_method": {"enum": ["provide_input", "request_revision", "request_waiver", "retry", "manual_resolution"]}, "status": {"enum": ["open", "in_progress", "waiting_for_input", "resolved", "cancelled"]}, "operator_action": {"$ref": "#/$defs/operator_action"}
  },
  "$defs": {
    "task_id": {"type": "string", "pattern": "^task-[a-z0-9][a-z0-9-]{7,63}$"}, "tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "step_id": {"type": "string", "enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "owner_role": {"enum": ["operator", "workflow_maintainer", "business_owner", "compliance_reviewer", "incident_responder"]}, "blocking_scope": {"enum": ["step", "run", "artifact", "project"]},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "content_sha256", "revision"], "properties": {"artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "revision": {"type": "integer", "minimum": 1}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "content_sha256"], "properties": {"evidence_id": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{7,63}$"}, "content_sha256": {"$ref": "#/$defs/sha256"}}}},
    "operator_action": {"type": "object", "additionalProperties": false, "required": ["action", "requested_by", "requested_at", "instructions"], "properties": {"action": {"enum": ["start_step", "request_revision", "request_input", "create_workflow_defect", "escalate_decision", "request_waiver", "approve_gate", "reject_gate", "resolve_task", "resume_run", "supersede_run"]}, "requested_by": {"type": "string", "pattern": "^(operator|reviewer)-[a-z0-9][a-z0-9-]{2,63}$"}, "requested_at": {"type": "string", "format": "date-time"}, "instructions": {"type": "string", "minLength": 1}}}
  }
}
