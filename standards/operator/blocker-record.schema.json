{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/operator/blocker-record.schema.json",
  "title": "Heartweb Blocker Record", "type": "object", "additionalProperties": false,
  "required": ["blocker_id", "tenant_id", "project_id", "run_id", "step_id", "blocker_type", "title", "description", "blocking_scope", "status", "artifact", "evidence", "reported_by", "reported_at"],
  "properties": {
    "blocker_id": {"type": "string", "pattern": "^blocker-[a-z0-9][a-z0-9-]{7,63}$"}, "tenant_id": {"$ref": "#/$defs/tenant_id"}, "project_id": {"$ref": "#/$defs/project_id"}, "run_id": {"$ref": "#/$defs/run_id"}, "step_id": {"$ref": "#/$defs/step_id"}, "blocker_type": {"enum": ["input", "technical", "quality", "compliance", "provider", "management"]}, "title": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "blocking_scope": {"enum": ["step", "run", "artifact", "project"]}, "status": {"enum": ["open", "resolved", "superseded"]}, "artifact": {"$ref": "#/$defs/artifact"}, "evidence": {"$ref": "#/$defs/evidence"}, "reported_by": {"type": "string", "minLength": 1}, "reported_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "step_id": {"type": "string", "enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "content_sha256", "revision"], "properties": {"artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "revision": {"type": "integer", "minimum": 1}}}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "content_sha256"], "properties": {"evidence_id": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{7,63}$"}, "content_sha256": {"$ref": "#/$defs/sha256"}}}}}
}
