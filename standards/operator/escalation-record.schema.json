{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/operator/escalation-record.schema.json",
  "title": "Heartweb Escalation Record", "type": "object", "additionalProperties": false,
  "required": ["escalation_id", "tenant_id", "project_id", "run_id", "step_id", "route", "title", "decision_owner_role", "options", "impacts", "deadline", "evidence", "blocking_scope", "final_decision", "status", "created_at"],
  "properties": {"escalation_id": {"type": "string", "pattern": "^escalation-[a-z0-9][a-z0-9-]{7,63}$"}, "tenant_id": {"$ref": "#/$defs/tenant_id"}, "project_id": {"$ref": "#/$defs/project_id"}, "run_id": {"$ref": "#/$defs/run_id"}, "step_id": {"$ref": "#/$defs/step_id"}, "route": {"enum": ["management_decision", "compliance_decision"]}, "title": {"type": "string", "minLength": 1}, "decision_owner_role": {"enum": ["business_owner", "compliance_reviewer"]}, "options": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["option_id", "description"], "properties": {"option_id": {"type": "string", "pattern": "^option-[a-z0-9][a-z0-9-]{2,63}$"}, "description": {"type": "string", "minLength": 1}}}}, "impacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "deadline": {"type": "string", "format": "date-time"}, "evidence": {"$ref": "#/$defs/evidence"}, "blocking_scope": {"enum": ["step", "run", "artifact", "project"]}, "final_decision": {"type": ["string", "null"], "minLength": 1}, "status": {"enum": ["open", "decided", "cancelled"]}, "created_at": {"type": "string", "format": "date-time"}},
  "$defs": {"tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "step_id": {"type": "string", "enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "content_sha256"], "properties": {"evidence_id": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{7,63}$"}, "content_sha256": {"$ref": "#/$defs/sha256"}}}}}
}
