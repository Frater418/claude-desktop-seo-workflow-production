{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/operator/resolution-record.schema.json",
  "title": "Heartweb Resolution Record", "type": "object", "additionalProperties": false,
  "required": ["resolution_id", "tenant_id", "project_id", "run_id", "step_id", "source_record", "artifact", "evidence", "verification_gate", "resolver", "resolved_at", "action", "resume_command", "status"],
  "properties": {"resolution_id": {"type": "string", "pattern": "^resolution-[a-z0-9][a-z0-9-]{7,63}$"}, "tenant_id": {"$ref": "#/$defs/tenant_id"}, "project_id": {"$ref": "#/$defs/project_id"}, "run_id": {"$ref": "#/$defs/run_id"}, "step_id": {"$ref": "#/$defs/step_id"}, "source_record": {"type": "object", "additionalProperties": false, "required": ["record_id", "record_type"], "properties": {"record_id": {"type": "string", "pattern": "^(task|blocker|revision|defect|escalation)-[a-z0-9][a-z0-9-]{7,63}$"}, "record_type": {"enum": ["operator_task", "blocker", "revision_request", "workflow_defect", "escalation"]}}}, "artifact": {"$ref": "#/$defs/artifact"}, "evidence": {"$ref": "#/$defs/evidence"}, "verification_gate": {"type": "object", "additionalProperties": false, "required": ["gate_id", "result"], "properties": {"gate_id": {"pattern": "^GATE-(0|1|1B|1C|2|3|3B|4A|4B)$"}, "result": {"const": "passed"}}}, "resolver": {"type": "string", "minLength": 1}, "resolved_at": {"type": "string", "format": "date-time"}, "action": {"type": "string", "minLength": 1}, "resume_command": {"$ref": "#/$defs/operator_action"}, "status": {"const": "resolved"}},
  "$defs": {"tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"}, "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"}, "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"}, "step_id": {"type": "string", "enum": ["0", "1", "1b", "1c", "2", "3", "3b", "4a", "4b"]}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "content_sha256", "revision"], "properties": {"artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "revision": {"type": "integer", "minimum": 1}}}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "content_sha256"], "properties": {"evidence_id": {"type": "string", "pattern": "^evidence-[a-z0-9][a-z0-9-]{7,63}$"}, "content_sha256": {"$ref": "#/$defs/sha256"}}}}, "operator_action": {"type": "object", "additionalProperties": false, "required": ["action", "requested_by", "requested_at", "instructions"], "properties": {"action": {"const": "resume_run"}, "requested_by": {"type": "string", "pattern": "^operator-[a-z0-9][a-z0-9-]{2,63}$"}, "requested_at": {"type": "string", "format": "date-time"}, "instructions": {"type": "string", "minLength": 1}}}}
}
