{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heartweb.example/schema/operator/production-steering.schema.json",
  "title": "Heartweb Versioned Production Steering",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "steering_id",
    "schema_version",
    "tenant_id",
    "project_id",
    "run_id",
    "step_id",
    "revision_request_id",
    "source_artifact",
    "findings",
    "instruction",
    "immutable_constraints",
    "status",
    "created_by",
    "created_at"
  ],
  "properties": {
    "steering_id": {"type": "string", "pattern": "^steering-[a-z0-9][a-z0-9-]{7,63}$"},
    "schema_version": {"const": "1.0.0"},
    "tenant_id": {"type": "string", "pattern": "^tenant-[a-z0-9][a-z0-9-]{2,63}$"},
    "project_id": {"type": "string", "pattern": "^project-[a-z0-9][a-z0-9-]{2,63}$"},
    "run_id": {"type": "string", "pattern": "^run-[a-z0-9][a-z0-9-]{7,63}$"},
    "step_id": {"enum": ["0", "1", "1b", "1c", "2", "3", "4a", "4b"]},
    "revision_request_id": {"type": "string", "pattern": "^revision-[a-z0-9][a-z0-9-]{7,63}$"},
    "source_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "content_sha256", "revision"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^artifact-[a-z0-9][a-z0-9-]{7,63}$"},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "revision": {"type": "integer", "minimum": 1}
      }
    },
    "findings": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "instruction": {"type": "string", "minLength": 1, "maxLength": 12000},
    "immutable_constraints": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "status": {"const": "active"},
    "created_by": {"type": "string", "pattern": "^operator-[a-z0-9][a-z0-9-]{2,63}$"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
