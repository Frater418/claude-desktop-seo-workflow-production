{
  "components": {
    "schemas": {
      "CommandRequest": {
        "additionalProperties": false,
        "description": "Closed transport shape for a single versioned command.",
        "properties": {
          "command": {
            "enum": [
              "start",
              "request-revision",
              "request-input",
              "create-defect",
              "escalate",
              "request-waiver",
              "approve",
              "reject",
              "resolve",
              "resume"
            ],
            "title": "Command",
            "type": "string"
          },
          "command_id": {
            "title": "Command Id",
            "type": "string"
          },
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "event": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Event",
            "type": "object"
          },
          "expected_revision": {
            "title": "Expected Revision",
            "type": "integer"
          },
          "idempotency_key": {
            "title": "Idempotency Key",
            "type": "string"
          },
          "operator_record": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Operator Record"
          },
          "project_id": {
            "title": "Project Id",
            "type": "string"
          },
          "record_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Record Type"
          },
          "run_id": {
            "title": "Run Id",
            "type": "string"
          },
          "step_id": {
            "title": "Step Id",
            "type": "string"
          },
          "tenant_id": {
            "title": "Tenant Id",
            "type": "string"
          },
          "transition_command": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transition Command"
          }
        },
        "required": [
          "command",
          "command_id",
          "correlation_id",
          "idempotency_key",
          "tenant_id",
          "project_id",
          "run_id",
          "step_id",
          "expected_revision",
          "event"
        ],
        "title": "CommandRequest",
        "type": "object"
      },
      "CommandResult": {
        "additionalProperties": false,
        "description": "Stable response wrapper for accepted or replayed commands.",
        "properties": {
          "command_id": {
            "title": "Command Id",
            "type": "string"
          },
          "correlation_id": {
            "title": "Correlation Id",
            "type": "string"
          },
          "event": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "title": "Event",
            "type": "object"
          },
          "replay": {
            "title": "Replay",
            "type": "boolean"
          },
          "run": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/JsonValue"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run"
          }
        },
        "required": [
          "command_id",
          "correlation_id",
          "replay",
          "event"
        ],
        "title": "CommandResult",
        "type": "object"
      },
      "DataEnvelope": {
        "additionalProperties": false,
        "description": "Stable response wrapper for a projection or command result.",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/JsonValue"
          }
        },
        "required": [
          "data"
        ],
        "title": "DataEnvelope",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JsonValue": {},
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
