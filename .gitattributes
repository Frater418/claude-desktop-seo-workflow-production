# Canonical cross-platform checkout bytes
* text=auto eol=lf

# Windows-native launchers
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary evidence and packaged assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.pdf binary
*.zip binary
*.ico binary
*.woff binary
*.woff2 binary
