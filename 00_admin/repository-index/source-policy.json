{
  "schema_version": "1.0.0",
  "registry_version": "1.0.0",
  "authority_order": [
    "00_admin/PROJECT_STATE.md",
    "00_admin/DECISIONS.md",
    "active plans",
    "standards and contracts",
    "current runtime and tests",
    "current integration documents",
    "supporting research",
    "historical and audit evidence"
  ],
  "include_globs": [
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "CHANGELOG.md",
    "00_admin/*.md",
    "00_admin/repository-index/*.md",
    "00_admin/meetings/**/*.md",
    "00_admin/audits/**/*.md",
    "00_admin/checkpoints/**/*.md",
    ".hermes/plans/*.md",
    ".hermes/plans/*.png",
    "docs/**/*.md",
    "docs/**/*.pdf",
    "docs/**/*.html",
    "prompts/*.md",
    "standards/**/*.md",
    "standards/**/*.json",
    "standards/**/*.css",
    "03_research/**/*.md",
    "03_research/**/*.json",
    "tests/*.md"
  ],
  "exclude_globs": [
    "00_admin/REPOSITORY_INDEX.md",
    "00_admin/SESSION_BOOTSTRAP.md",
    "00_admin/repository-index/DOCUMENT_REGISTRY.json",
    "00_admin/repository-index/DOCUMENT_REGISTRY.jsonl",
    "docs/INDEX.md",
    ".hermes/plans/INDEX.md",
    "00_admin/audits/INDEX.md",
    "03_research/INDEX.md",
    "**/.env",
    "**/.env.*",
    "**/node_modules/**",
    "**/.omo/**",
    "**/.codegraph/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**"
  ],
  "strict_override_globs": [
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "CHANGELOG.md",
    "00_admin/PROJECT_STATE.md",
    "00_admin/DECISIONS.md",
    "00_admin/DEFERRED_INTEGRATION_BACKLOG.md",
    "00_admin/POST_RELEASE_BACKLOG.md",
    "00_admin/MASTER_TASK_MATRIX.md",
    "00_admin/repository-index/*.md",
    ".hermes/plans/*.md",
    "docs/**/*.md"
  ],
  "auto_rules": [
    {
      "prefix": "00_admin/repository-index/",
      "document_type": "repository_governance",
      "area": "governance",
      "lifecycle": "current_strategy",
      "authority_level": 80,
      "retrieval_priority": 72,
      "default_retrieval": false,
      "audiences": ["operator", "developer", "llm-worker"],
      "tags": ["repository-index", "integration"]
    },
    {
      "prefix": "00_admin/audits/",
      "document_type": "audit_evidence",
      "area": "audits",
      "lifecycle": "evidence",
      "authority_level": 10,
      "retrieval_priority": 10,
      "default_retrieval": false,
      "audiences": ["auditor", "developer"],
      "tags": ["audit", "evidence"]
    },
    {
      "prefix": "00_admin/checkpoints/",
      "document_type": "checkpoint_evidence",
      "area": "checkpoints",
      "lifecycle": "evidence",
      "authority_level": 10,
      "retrieval_priority": 8,
      "default_retrieval": false,
      "audiences": ["auditor", "developer"],
      "tags": ["checkpoint", "immutable-evidence"]
    },
    {
      "prefix": "00_admin/meetings/",
      "document_type": "meeting_source",
      "area": "meetings",
      "lifecycle": "evidence",
      "authority_level": 20,
      "retrieval_priority": 20,
      "default_retrieval": false,
      "audiences": ["operator", "strategy"],
      "tags": ["meeting", "source"]
    },
    {
      "prefix": ".hermes/plans/",
      "document_type": "plan",
      "area": "plans",
      "lifecycle": "needs_reconciliation",
      "authority_level": 40,
      "retrieval_priority": 30,
      "default_retrieval": false,
      "audiences": ["developer", "operator"],
      "tags": ["plan"]
    },
    {
      "prefix": "docs/",
      "document_type": "documentation",
      "area": "docs",
      "lifecycle": "needs_reconciliation",
      "authority_level": 35,
      "retrieval_priority": 25,
      "default_retrieval": false,
      "audiences": ["operator", "developer"],
      "tags": ["documentation"]
    },
    {
      "prefix": "prompts/",
      "document_type": "prompt_contract",
      "area": "prompts",
      "lifecycle": "current_authority",
      "authority_level": 82,
      "retrieval_priority": 80,
      "default_retrieval": false,
      "audiences": ["llm-worker", "operator"],
      "tags": ["prompt", "workflow"]
    },
    {
      "prefix": "standards/",
      "document_type": "standard_or_contract",
      "area": "standards",
      "lifecycle": "current_authority",
      "authority_level": 85,
      "retrieval_priority": 78,
      "default_retrieval": false,
      "audiences": ["llm-worker", "developer", "validator"],
      "tags": ["standard", "contract"]
    },
    {
      "prefix": "03_research/",
      "document_type": "research_source",
      "area": "research",
      "lifecycle": "evidence",
      "authority_level": 20,
      "retrieval_priority": 18,
      "default_retrieval": false,
      "audiences": ["strategy", "researcher"],
      "tags": ["research", "evidence"]
    },
    {
      "prefix": "tests/",
      "document_type": "test_evidence",
      "area": "tests",
      "lifecycle": "evidence",
      "authority_level": 30,
      "retrieval_priority": 20,
      "default_retrieval": false,
      "audiences": ["developer", "auditor"],
      "tags": ["test", "evidence"]
    },
    {
      "prefix": "",
      "document_type": "governance",
      "area": "root",
      "lifecycle": "needs_reconciliation",
      "authority_level": 40,
      "retrieval_priority": 30,
      "default_retrieval": false,
      "audiences": ["operator", "developer"],
      "tags": ["governance"]
    }
  ]
}
